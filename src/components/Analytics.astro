---
import { site } from '../data/site';
const id = site.analytics.ga4;
---
{id && (
  <script is:inline define:vars={{ id }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', id, { anonymize_ip: true });
    // GTM (~166 КБ) не потрібен для першого рендеру. Вантажимо його поза
    // критичним шляхом — на першу взаємодію або через 3.5с (що раніше),
    // тож він не блокує головний потік (нижчий TBT, швидший LCP). Перегляд
    // сторінки не втрачається: config уже в dataLayer, скрипт його дошле.
    var gtmLoaded = false;
    function loadGtm(){
      if (gtmLoaded) return; gtmLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
      document.head.appendChild(s);
    }
    ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function(evt){
      window.addEventListener(evt, loadGtm, { once: true, passive: true });
    });
    setTimeout(loadGtm, 3500);
  </script>
)}

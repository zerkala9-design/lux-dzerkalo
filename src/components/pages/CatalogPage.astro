---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../ProductCard.astro';
import CallbackForm from '../CallbackForm.astro';
import { categories, catTitle } from '../../data/categories';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';
import { getProductsByLang } from '../../lib/products';
import { landings } from '../../data/landings';
import { site } from '../../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Навігація «за типом» — робить каталог повноцінним хабом «дзеркала на замовлення»
const lp = (k: string) => (lang === 'ru' ? `/ru/${landings[k].slugRu}/` : `/${landings[k].slugUk}/`);
const P = (p: string) => localizePath(p, lang);
const typeLinks = [
  { uk: 'Дзеркала для ванної', ru: 'Зеркала для ванной', href: P('/katalog/dzerkala-dlya-vannoyi/') },
  { uk: 'З LED-підсвіткою', ru: 'С LED-подсветкой', href: P('/katalog/dzerkala-z-led-pidsvitkoyu/') },
  { uk: 'З фацетом', ru: 'С фацетом', href: P('/katalog/dzerkala-z-fatsetom/') },
  { uk: 'Дзеркальна плитка', ru: 'Зеркальная плитка', href: P('/katalog/dzerkalna-plitka/') },
  { uk: 'Дзеркальні панно', ru: 'Зеркальные панно', href: P('/katalog/dzerkalni-panno/') },
  { uk: 'Для спортзалів і студій', ru: 'Для спортзалов и студий', href: P('/katalog/dzerkala-dlya-sportzaliv/') },
  { uk: "Дзеркала в інтер'єрі", ru: 'Зеркала в интерьере', href: P('/katalog/dzerkala-v-interyeri/') },
  { uk: 'У передпокій і коридор', ru: 'В прихожую и коридор', href: P('/statti/dzerkalo-u-peredpokiy/') },
  { uk: 'У вітальню', ru: 'В гостиную', href: P('/statti/dzerkalo-u-vitalnyu/') },
  { uk: 'У спальню', ru: 'В спальню', href: P('/statti/dzerkalo-u-spalnyu/') },
  { uk: 'Підлогові дзеркала', ru: 'Напольные зеркала', href: lp('pidlohovi') },
  { uk: 'Аркові дзеркала', ru: 'Арочные зеркала', href: lp('arkovi') },
  { uk: 'У повний зріст', ru: 'В полный рост', href: P('/tovar/dzerkalo-u-povnyy-zrist/') },
  { uk: 'На стіну', ru: 'На стену', href: P('/tovar/dzerkalo-na-stinu/') },
  { uk: 'Круглі та овальні', ru: 'Круглые и овальные', href: P('/statti/krugle-dzerkalo-na-zamovlennya/') },
  { uk: 'Тоновані (графіт, бронза)', ru: 'Тонированные (графит, бронза)', href: P('/statti/tonovane-dzerkalo-grafit-bronza/') },
  { uk: 'Декоративні', ru: 'Декоративные', href: P('/statti/zerkala-dekorativnye/') },
  { uk: 'Гримерні (візажні)', ru: 'Гримёрные (визажные)', href: P('/tovar/grymerne-dzerkalo/') },
  { uk: 'Дзеркальні панелі', ru: 'Зеркальные панели', href: lp('paneli') },
  { uk: 'Для спортзалу під ключ', ru: 'Для спортзала под ключ', href: lp('sportzalPk') },
  { uk: 'Для кав\'ярні та фотозони', ru: 'Для кофейни и фотозоны', href: lp('kavyarnya') },
  { uk: 'LED-дзеркала на замовлення', ru: 'LED-зеркала на заказ', href: lp('led') },
].map((x) => ({ label: lang === 'ru' ? x.ru : x.uk, href: x.href }));
const typesHeading = lang === 'ru' ? 'Зеркала на заказ — по типу' : 'Дзеркала на замовлення — за типом';
const trust = lang === 'ru'
  ? 'Производитель с 2011 · замеры и монтаж под ключ · доставка НП по Украине'
  : 'Виробник з 2011 · заміри та монтаж під ключ · доставка НП по Україні';
// У загальному каталозі показуємо лише «вітринні» товари; розмірні варіанти
// (catalogHidden) живуть тільки у своїй категорії, щоб не дублювати сітку.
const products = (await getProductsByLang(lang)).filter((p) => !p.data.catalogHidden);

const base = localizePath('/', lang);
const catalogUrl = new URL(localizePath('/katalog/', lang), site.url).href;

// SEO під запит «магазин дзеркал Київ / магазин зеркал Киев»
const metaTitle = lang === 'ru'
  ? 'Каталог зеркал — магазин зеркал в Киеве'
  : 'Каталог дзеркал — магазин дзеркал у Києві';
const metaDesc = lang === 'ru'
  ? 'Магазин зеркал в Киеве от производителя: зеркала для ванной, с LED-подсветкой, с фацетом, зеркальная плитка, панно и зеркала для спортзалов. Изготовление на заказ по вашим размерам, доставка по Украине.'
  : 'Магазин дзеркал у Києві від виробника: дзеркала для ванної, з LED-підсвіткою, з фацетом, дзеркальна плитка, панно та дзеркала для спортзалів. Виготовлення на замовлення за вашими розмірами, доставка по Україні.';
const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: new URL(base, site.url).href },
    { '@type': 'ListItem', position: 2, name: t('catalog.title'), item: catalogUrl },
  ],
};
---

<BaseLayout title={metaTitle} description={metaDesc} jsonLd={breadcrumbsLd}>
  <section class="page-head">
    <div class="container">
      <nav class="crumbs"><a href={base}>{t('nav.home')}</a> / <span>{t('catalog.title')}</span></nav>
      <h1>{t('catalog.title')}</h1>
      <p>{t('catalog.intro')}</p>
      <p class="catalog-trust">{trust}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="chips">
        {categories.map((c) => (
          <a href={localizePath(`/katalog/${c.slug}/`, lang)} class="chip">{catTitle(c, lang)}</a>
        ))}
      </div>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {products.map((p) => <ProductCard product={p} />)}
      </div>

      <div class="types">
        <h2>{typesHeading}</h2>
        <ul class="types__list">
          {typeLinks.map((x) => (<li><a href={x.href}>{x.label}</a></li>))}
        </ul>
      </div>
    </div>
  </section>

  <CallbackForm />
</BaseLayout>

<style>
  .page-head { padding: clamp(16px, 2vw, 26px) 0 0; background: var(--bg-soft); }
  .page-head .container { padding-bottom: clamp(16px, 2vw, 26px); }
  .crumbs { font-size: 0.88rem; color: var(--muted); margin-bottom: 1rem; }
  .crumbs a { color: var(--ink-soft); }
  .page-head p { color: var(--ink-soft); max-width: 60ch; font-size: 1.08rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { padding: 0.5em 1.1em; border-radius: 999px; border: 1.5px solid var(--line); color: var(--ink); font-size: 0.92rem; font-weight: 500; background: #fff; }
  .chip:hover { border-color: var(--accent); color: var(--accent-dark); }
  .catalog-trust { margin-top: 0.8rem; font-size: 0.92rem; color: var(--accent-dark); font-weight: 600; }
  .types { margin-top: 3rem; }
  .types h2 { font-family: var(--serif); font-size: 1.4rem; margin-bottom: 1rem; }
  .types__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 8px 20px; }
  .types__list a { display: block; padding: 8px 0; color: var(--ink); border-bottom: 1px solid var(--line); font-size: 0.96rem; }
  .types__list a:hover { color: var(--accent-dark); }
</style>

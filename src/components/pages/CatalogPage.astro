---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../ProductCard.astro';
import CallbackForm from '../CallbackForm.astro';
import { categories, catTitle } from '../../data/categories';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';
import { getProductsByLang } from '../../lib/products';
import { site } from '../../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const products = await getProductsByLang(lang);

const base = localizePath('/', lang);
const catalogUrl = new URL(localizePath('/katalog/', lang), site.url).href;
const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: new URL(base, site.url).href },
    { '@type': 'ListItem', position: 2, name: t('catalog.title'), item: catalogUrl },
  ],
};
---

<BaseLayout title={t('catalog.title')} description={t('catalog.intro')} jsonLd={breadcrumbsLd}>
  <section class="page-head">
    <div class="container">
      <nav class="crumbs"><a href={base}>{t('nav.home')}</a> / <span>{t('catalog.title')}</span></nav>
      <h1>{t('catalog.title')}</h1>
      <p>{t('catalog.intro')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="chips">
        {categories.map((c) => (
          <a href={localizePath(`/katalog/${c.slug}/`, lang)} class="chip">{catTitle(c, lang)}</a>
        ))}
      </div>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {products.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <CallbackForm />
</BaseLayout>

<style>
  .page-head { padding: clamp(24px, 3vw, 40px) 0 0; background: var(--bg-soft); }
  .page-head .container { padding-bottom: clamp(24px, 3vw, 40px); }
  .crumbs { font-size: 0.88rem; color: var(--muted); margin-bottom: 1rem; }
  .crumbs a { color: var(--ink-soft); }
  .page-head p { color: var(--ink-soft); max-width: 60ch; font-size: 1.08rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { padding: 0.5em 1.1em; border-radius: 999px; border: 1.5px solid var(--line); color: var(--ink); font-size: 0.92rem; font-weight: 500; background: #fff; }
  .chip:hover { border-color: var(--accent); color: var(--accent-dark); }
</style>

---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../ProductCard.astro';
import CallbackForm from '../CallbackForm.astro';
import Faq from '../Faq.astro';
import Reviews from '../Reviews.astro';
import { site } from '../../data/site';
import { categories, catTitle, catShort } from '../../data/categories';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';
import { getProductsByLang } from '../../lib/products';
import { getHomeFaq } from '../../data/faq';
import heroImg from '../../assets/hero.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Короткий meta-опис головної (≤160 симв.) — багатий опис лишається у schema.
const homeDesc = lang === 'ru'
  ? 'Производитель зеркал в Киеве с 2011: на заказ по размеру — ванная, фацет, LED-подсветка, панно, спортзалы. Замеры, монтаж, доставка Новой Почтой.'
  : 'Виробник дзеркал у Києві з 2011: на замовлення за розміром — ванна, фацет, LED-підсвітка, панно, спортзали. Заміри, монтаж, доставка Новою Поштою.';

const products = await getProductsByLang(lang);
const featured = products.filter((p) => p.data.featured).slice(0, 4);
const faqItems = getHomeFaq(lang);

// SEO-заголовок головної під головний запит (з містом і наміром)
const homeTitle = lang === 'ru'
  ? 'Зеркала на заказ в Киеве — производитель'
  : 'Дзеркала на замовлення в Києві — виробник';

const advantages = [
  { icon: '📐', title: t('adv.1.title'), text: t('adv.1.text') },
  { icon: '🛠️', title: t('adv.2.title'), text: t('adv.2.text') },
  { icon: '⏱️', title: t('adv.3.title'), text: t('adv.3.text') },
  { icon: '🛡️', title: t('adv.4.title'), text: t('adv.4.text') },
];
const steps = [
  { n: '01', title: t('proc.1.title'), text: t('proc.1.text') },
  { n: '02', title: t('proc.2.title'), text: t('proc.2.text') },
  { n: '03', title: t('proc.3.title'), text: t('proc.3.text') },
  { n: '04', title: t('proc.4.title'), text: t('proc.4.text') },
];

// Внутрішня перелінковка на ключові (money) статті — обидві мови мають цей slug.
const topics = [
  { slug: 'dzerkala-na-zamovlennya-v-kievi', uk: 'Дзеркала на замовлення в Києві', ru: 'Зеркала на заказ в Киеве' },
  { slug: 'dzerkala-dlya-zaliv-i-studiy', uk: 'Дзеркала для залів і студій', ru: 'Зеркала для залов и студий' },
  { slug: 'dzerkalo-u-vannu-kimnatu-kiyiv', uk: 'Дзеркало у ванну кімнату', ru: 'Зеркало в ванную комнату' },
  { slug: 'dzerkalo-z-led-pidsvitkoyu-yak-vybraty', uk: 'Дзеркало з LED-підсвіткою: як вибрати', ru: 'Зеркало с LED-подсветкой: как выбрать' },
  { slug: 'dzerkalo-z-fatsetom-shcho-tse', uk: 'Що таке дзеркало з фацетом', ru: 'Что такое зеркало с фацетом' },
  { slug: 'dzerkalna-plitka-u-vannu-ta-na-stinu', uk: 'Дзеркальна плитка у ванну та на стіну', ru: 'Зеркальная плитка в ванную и на стену' },
];
const topicsHeading = lang === 'ru' ? 'Полезно знать' : 'Корисно знати';
---

<BaseLayout title={homeTitle} description={homeDesc} withReviews={true}>
  <section class="hero">
    <div class="hero__bg">
      <Image src={heroImg} alt={t('site.tagline')} widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="hero__overlay"></div>
    </div>
    <div class="container hero__inner">
      <span class="eyebrow hero__eyebrow">{t('hero.eyebrow')}</span>
      <h1 set:html={t('hero.title')}></h1>
      <p>{t('hero.subtitle')}</p>
      <div class="hero__actions">
        <a href="#zayavka" class="btn btn--primary">{t('hero.ctaQuote')}</a>
        <a href={localizePath('/katalog/', lang)} class="btn btn--light">{t('hero.ctaCatalog')}</a>
      </div>
      <div class="hero__contacts">
        {site.phones.map((p) => (<a href={`tel:${p.tel}`}>{p.display}</a>))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--4">
        {advantages.map((a) => (
          <div class="adv">
            <span class="adv__icon" aria-hidden="true">{a.icon}</span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">{t('cat.eyebrow')}</span>
        <h2>{t('cat.heading')}</h2>
        <p>{t('cat.sub')}</p>
      </div>
      <div class="grid grid--4 cat-grid">
        {categories.map((c) => (
          <a href={localizePath(`/katalog/${c.slug}/`, lang)} class="cat-tile">
            <h3>{catTitle(c, lang)}</h3>
            <p>{catShort(c, lang)}</p>
            <span class="link-arrow">{t('common.more')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">{t('feat.eyebrow')}</span>
        <h2>{t('feat.heading')}</h2>
        <p>{t('feat.sub')}</p>
      </div>
      <div class="grid grid--4">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
      <div style="text-align:center; margin-top: 2.5rem;">
        <a href={localizePath('/katalog/', lang)} class="btn btn--ghost">{t('common.allCatalog')}</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">{t('proc.eyebrow')}</span>
        <h2>{t('proc.heading')}</h2>
      </div>
      <div class="grid grid--4">
        {steps.map((s) => (
          <div class="step">
            <span class="step__n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">{topicsHeading}</span>
        <h2>{t('articles.title')}</h2>
      </div>
      <div class="topic-links">
        {topics.map((tp) => (
          <a href={localizePath(`/statti/${tp.slug}/`, lang)} class="topic-link">
            <span>{lang === 'ru' ? tp.ru : tp.uk}</span>
            <span class="link-arrow">{t('common.more')}</span>
          </a>
        ))}
      </div>
      <div style="text-align:center; margin-top: 2rem;">
        <a href={localizePath('/statti/', lang)} class="btn btn--ghost">{t('articles.all')}</a>
      </div>
    </div>
  </section>

  <Reviews />

  <Faq items={faqItems} heading={t('faq.heading')} />

  <CallbackForm />
</BaseLayout>

<style>
  .hero { position: relative; color: #fff; isolation: isolate; }
  .hero__bg { position: absolute; inset: 0; z-index: -1; }
  .hero__bg img { width: 100%; height: 100%; object-fit: cover; }
  .hero__overlay { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(12,16,22,0.92) 0%, rgba(12,16,22,0.78) 42%, rgba(12,16,22,0.45) 70%, rgba(12,16,22,0.3) 100%); }
  .hero__inner { padding: clamp(70px, 12vw, 150px) 20px; }
  .hero__inner > * { max-width: 620px; }
  .hero__eyebrow { color: var(--accent); }
  .hero h1 { color: #fff; overflow-wrap: break-word; }
  @media (max-width: 560px) { .hero h1 { font-size: clamp(1.72rem, 8vw, 2.3rem); } }
  .hero p { color: #d7dde4; font-size: 1.15rem; max-width: 56ch; }
  .hero__actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 1.8rem; }
  .hero__contacts { display: flex; gap: 24px; margin-top: 1.8rem; flex-wrap: wrap; }
  .hero__contacts a { color: #fff; font-weight: 700; font-size: 1.15rem; font-family: var(--font); letter-spacing: 0.03em; }
  .hero__contacts a:hover { color: var(--accent); }

  .adv { text-align: left; }
  .adv__icon { font-size: 2rem; display: block; margin-bottom: 0.6rem; }
  .adv h3 { font-size: 1.15rem; }
  .adv p { color: var(--ink-soft); font-size: 0.96rem; }

  .cat-tile { display: flex; flex-direction: column; gap: 0.3rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 22px; color: var(--ink); transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
  .cat-tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: transparent; }
  .cat-tile h3 { font-size: 1.18rem; margin-bottom: 0.2rem; }
  .cat-tile p { color: var(--ink-soft); font-size: 0.93rem; flex: 1; margin-bottom: 0.8rem; }

  .topic-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .topic-link { display: flex; flex-direction: column; gap: 0.6rem; justify-content: space-between; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; color: var(--ink); font-weight: 600; transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
  .topic-link:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); border-color: transparent; }
  @media (max-width: 1000px) { .topic-links { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .topic-links { grid-template-columns: 1fr; } }

  .step { position: relative; padding-top: 8px; }
  .step__n { font-family: var(--serif); font-size: 2.6rem; font-weight: 700; color: var(--accent); opacity: 0.5; display: block; line-height: 1; }
  .step h3 { margin-top: 0.6rem; font-size: 1.2rem; }
  .step p { color: var(--ink-soft); font-size: 0.96rem; }
</style>

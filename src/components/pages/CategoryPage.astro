---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../ProductCard.astro';
import CallbackForm from '../CallbackForm.astro';
import GymHook from '../GymHook.astro';
import Faq from '../Faq.astro';
import { categories, getCategoryBySlug, catTitle, catDescription } from '../../data/categories';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';
import { getProductsByLang } from '../../lib/products';
import { getCategoryFaq } from '../../data/faq';
import { site } from '../../data/site';

interface Props { slug: string; }
const { slug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const category = getCategoryBySlug(slug)!;

const products = (await getProductsByLang(lang)).filter((p) => p.data.category === category.key);
const base = localizePath('/', lang);
const faqItems = getCategoryFaq(category.key, lang);

// Перелінковка категорія → профільна (money) стаття. Усі slug існують в обох мовах.
const pillarMap: Record<string, { slug: string; uk: string; ru: string }> = {
  vanna: { slug: 'dzerkalo-u-vannu-kimnatu-kiyiv', uk: 'Дзеркало у ванну кімнату: як вибрати', ru: 'Зеркало в ванную комнату: как выбрать' },
  led: { slug: 'dzerkalo-z-led-pidsvitkoyu-yak-vybraty', uk: 'Дзеркало з LED-підсвіткою: як вибрати', ru: 'Зеркало с LED-подсветкой: как выбрать' },
  facet: { slug: 'dzerkalo-z-fatsetom-shcho-tse', uk: 'Що таке дзеркало з фацетом', ru: 'Что такое зеркало с фацетом' },
  plitka: { slug: 'dzerkalna-plitka-u-vannu-ta-na-stinu', uk: 'Дзеркальна плитка у ванну та на стіну', ru: 'Зеркальная плитка в ванную и на стену' },
  sportzal: { slug: 'dzerkala-dlya-zaliv-i-studiy', uk: 'Дзеркала для залів і студій: розміри та монтаж', ru: 'Зеркала для залов и студий: размеры и монтаж' },
  interier: { slug: 'dzerkalo-v-kvartyru', uk: 'Дзеркало в квартиру: види, розміри, куди повісити', ru: 'Зеркало в квартиру: виды, размеры, куда повесить' },
  panno: { slug: 'dzerkalne-panno-v-ukrayini---stilniy-ta-funktsionalniy-element', uk: 'Дзеркальне панно з фацетом: види, розкладка та ціна', ru: 'Зеркальное панно с фацетом: виды, раскладка и цена' },
};
const pillar = pillarMap[category.key];
const pillarLabel = pillar ? (lang === 'ru' ? pillar.ru : pillar.uk) : '';

// sportzal — блок під запит «дзеркало в спортзал на стіну» (синоніми + таблиця розмірів/цін для AEO)
const gymIntro = lang === 'ru'
  ? 'Изготавливаем <strong>зеркало в спортзал, тренажёрный зал и танцевальную студию на стену</strong> — по вашим размерам. Ставим большие сплошные полотна для фитнес-клубов, залов единоборств, кроссфита и домашнего зала: стекло 4 мм (6 мм для больших полотен), полированный край, по желанию — плёнка безопасности и надёжное крепление. Замер и монтаж своей бригадой в Киеве и области, доставка Новой Почтой по Украине.'
  : 'Виготовляємо <strong>дзеркало в спортзал, тренажерний зал і танцювальну студію на стіну</strong> — за вашими розмірами. Ставимо великі суцільні полотна для фітнес-клубів, залів єдиноборств, кросфіту та домашнього залу: скло 4 мм (6 мм для великих полотен), полірований край, за бажанням — плівка безпеки й надійне кріплення. Замір і монтаж власною бригадою в Києві та області, доставка Новою Поштою по Україні.';
const gymSizes = [
  { size: '1000 × 1000 мм', area: '1 м²', price: 'від 1400 грн', priceRu: 'от 1400 грн' },
  { size: '1500 × 1000 мм', area: '1,5 м²', price: 'від 2100 грн', priceRu: 'от 2100 грн' },
  { size: '2000 × 1000 мм', area: '2 м²', price: 'від 2800 грн', priceRu: 'от 2800 грн' },
  { size: '2000 × 1500 мм', area: '3 м²', price: 'від 4200 грн', priceRu: 'от 4200 грн' },
  { size: '2500 × 2000 мм', area: '5 м²', price: 'від 7000 грн', priceRu: 'от 7000 грн' },
];
const gymTableHead = lang === 'ru' ? ['Размер полотна', 'Площадь', 'Ориентировочная цена'] : ['Розмір полотна', 'Площа', 'Орієнтовна ціна'];
const gymTableTitle = lang === 'ru' ? 'Зеркало в спортзал на стену: размеры и цена' : 'Дзеркало в спортзал на стіну: розміри й ціна';
const gymNote = lang === 'ru'
  ? 'Ориентировочно, за полотно 4 мм без плёнки и крепления. Плёнка безопасности +100 грн, комплект крепления +85 грн. Большие полотна (6 мм) — дороже, макс. размер 3200×2200 мм. Точная цена — после бесплатного замера.'
  : 'Орієнтовно, за полотно 4 мм без плівки та кріплення. Плівка безпеки +100 грн, комплект кріплення +85 грн. Великі полотна (6 мм) — дорожче, макс. розмір 3200×2200 мм. Точна ціна — після безкоштовного заміру.';

// Заголовок із локальним наміром (під пошукові запити «… в Києві / в Киеве»)
// sportzal — точний збіг із головним комерційним запитом «дзеркало в спортзал … на стіну»
const seoOverride: Record<string, { titleUk: string; titleRu: string; h1Uk: string; h1Ru: string }> = {
  sportzal: {
    titleUk: 'Дзеркало в спортзал на стіну — на замовлення за розміром, Київ',
    titleRu: 'Зеркало в спортзал на стену — на заказ по размеру, Киев',
    h1Uk: 'Дзеркало в спортзал на стіну',
    h1Ru: 'Зеркало в спортзал на стену',
  },
};
const ov = seoOverride[category.key];
const metaTitle = ov
  ? (lang === 'ru' ? ov.titleRu : ov.titleUk)
  : (lang === 'ru'
      ? `${catTitle(category, lang)} на заказ в Киеве`
      : `${catTitle(category, lang)} на замовлення в Києві`);
const pageH1 = ov ? (lang === 'ru' ? ov.h1Ru : ov.h1Uk) : catTitle(category, lang);

// Тригери довіри під комерційні запити (реальні факти)
const trust = lang === 'ru'
  ? ['Производитель с 2011', 'Замеры и монтаж под ключ', 'Цена от производителя', 'Доставка НП по Украине']
  : ['Виробник з 2011', 'Заміри та монтаж під ключ', 'Ціна від виробника', 'Доставка НП по Україні'];

const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: new URL(base, site.url).href },
    { '@type': 'ListItem', position: 2, name: t('catalog.title'), item: new URL(localizePath('/katalog/', lang), site.url).href },
    { '@type': 'ListItem', position: 3, name: catTitle(category, lang), item: new URL(localizePath(`/katalog/${category.slug}/`, lang), site.url).href },
  ],
};
---

<BaseLayout title={metaTitle} description={catDescription(category, lang)} jsonLd={breadcrumbsLd}>
  <section class="page-head">
    <div class="container">
      <nav class="crumbs">
        <a href={base}>{t('nav.home')}</a> / <a href={localizePath('/katalog/', lang)}>{t('catalog.title')}</a> / <span>{catTitle(category, lang)}</span>
      </nav>
      <h1>{pageH1}</h1>
      <p>{catDescription(category, lang)}</p>
      <ul class="trust-strip">
        {trust.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {category.key === 'sportzal' && <GymHook />}
      <div class="chips">
        {categories.map((c) => (
          <a href={localizePath(`/katalog/${c.slug}/`, lang)} class:list={['chip', { active: c.slug === category.slug }]}>
            {catTitle(c, lang)}
          </a>
        ))}
      </div>

      {products.length > 0 ? (
        <div class="grid grid--3" style="margin-top: 2.5rem;">
          {products.map((p) => <ProductCard product={p} />)}
        </div>
      ) : (
        <p style="margin-top:2rem;"><a href="#zayavka">{t('catalog.empty')}</a></p>
      )}
    </div>
  </section>

  {category.key === 'sportzal' && (
    <section class="section">
      <div class="container gym-block">
        <p set:html={gymIntro}></p>
        <h2>{gymTableTitle}</h2>
        <div class="gym-table-wrap">
          <table class="gym-table">
            <thead>
              <tr>{gymTableHead.map((h) => <th>{h}</th>)}</tr>
            </thead>
            <tbody>
              {gymSizes.map((r) => (
                <tr>
                  <td>{r.size}</td>
                  <td>{r.area}</td>
                  <td><strong>{lang === 'ru' ? r.priceRu : r.price}</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="gym-note">{gymNote}</p>
      </div>
    </section>
  )}

  {pillar && pillarLabel && (
    <section class="section">
      <div class="container">
        <a href={localizePath(`/statti/${pillar.slug}/`, lang)} class="pillar-link">
          <span class="eyebrow">{lang === 'ru' ? 'Читайте также' : 'Читайте також'}</span>
          <strong>{pillarLabel}</strong>
          <span class="link-arrow">{t('articles.readMore')}</span>
        </a>
      </div>
    </section>
  )}

  <Faq items={faqItems} heading={t('faq.heading')} soft={true} />

  <CallbackForm />
</BaseLayout>

<style>
  .page-head { padding: clamp(16px, 2vw, 26px) 0 0; background: var(--bg-soft); }
  .page-head .container { padding-bottom: clamp(16px, 2vw, 26px); }
  .crumbs { font-size: 0.88rem; color: var(--muted); margin-bottom: 1rem; }
  .crumbs a { color: var(--ink-soft); }
  .page-head p { color: var(--ink-soft); max-width: 65ch; font-size: 1.08rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { padding: 0.5em 1.1em; border-radius: 999px; border: 1.5px solid var(--line); color: var(--ink); font-size: 0.92rem; font-weight: 500; background: #fff; }
  .chip:hover { border-color: var(--accent); color: var(--accent-dark); }
  .chip.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .trust-strip { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .trust-strip li { position: relative; padding-left: 22px; font-size: 0.9rem; color: var(--ink-soft); font-weight: 500; }
  .trust-strip li::before { content: '✓'; position: absolute; left: 0; color: var(--accent-dark); font-weight: 700; }
  .pillar-link { display: flex; flex-direction: column; gap: 0.5rem; background: var(--accent-soft); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 26px; color: var(--ink); }
  .pillar-link strong { font-family: var(--serif); font-size: 1.3rem; }
  .pillar-link:hover { border-color: var(--accent); }

  .gym-block { max-width: 900px; }
  .gym-block > p { color: var(--ink-soft); font-size: 1.05rem; }
  .gym-block h2 { margin: 1.6rem 0 1rem; font-size: 1.5rem; }
  .gym-table-wrap { overflow-x: auto; }
  .gym-table { width: 100%; border-collapse: collapse; font-size: 1rem; }
  .gym-table th, .gym-table td { border: 1px solid var(--line); padding: 11px 14px; text-align: left; }
  .gym-table thead th { background: var(--bg-dark); color: #fff; font-family: var(--font); font-weight: 600; font-size: 0.95rem; }
  .gym-table tbody tr:nth-child(even) { background: var(--bg-soft); }
  .gym-note { color: var(--muted); font-size: 0.88rem; margin-top: 0.8rem; }
</style>

---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CallbackForm from '../CallbackForm.astro';
import GymHook from '../GymHook.astro';
import Faq from '../Faq.astro';
import { site } from '../../data/site';
import { landings } from '../../data/landings';
import { offerShippingDetails, merchantReturnPolicy } from '../../lib/schema';
import { getLangFromUrl, localizePath } from '../../i18n/ui';

interface Props { id: string }
const { id } = Astro.props;
const landing = landings[id];
const lang = getLangFromUrl(Astro.url);
const c = landing[lang];

// Фото реальної роботи (з src/assets/gallery/) — необов'язкове
const galleryImgs = import.meta.glob<{ default: ImageMetadata }>('../../assets/gallery/*.{jpg,jpeg,png,webp}', { eager: true });
const workImg = landing.image
  ? Object.entries(galleryImgs).find(([p]) => p.endsWith('/' + landing.image))?.[1].default
  : undefined;
const imgAlt = landing.imageAlt ? landing.imageAlt[lang] : c.h1;

// Абсолютний URL емітованого JPEG для schema (workImg.src може вести на неемітований оригінал → 404).
const workImgUrl = workImg
  ? new URL((await getImage({ src: workImg, format: 'jpeg', width: 1200 })).src, site.url).href
  : new URL('/og-default.jpg', site.url).href;

const path = lang === 'ru' ? `/ru/${landing.slugRu}/` : `/${landing.slugUk}/`;
const canonical = new URL(path, site.url).href;
const hreflang = { uk: `/${landing.slugUk}/`, ru: `/ru/${landing.slugRu}/` };
const homeHref = localizePath('/', lang);

const businessId = `${site.url}/#business`;

const mainLd = landing.schemaType === 'Product'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: c.h1,
      description: c.metaDescription,
      image: workImgUrl,
      brand: { '@type': 'Brand', name: site.name },
      ...(landing.price
        ? {
            offers: {
              '@type': 'Offer',
              price: landing.price,
              priceCurrency: 'UAH',
              availability: 'https://schema.org/InStock',
              itemCondition: 'https://schema.org/NewCondition',
              url: canonical,
              seller: { '@type': 'Organization', '@id': businessId, name: site.name },
              shippingDetails: offerShippingDetails,
              hasMerchantReturnPolicy: merchantReturnPolicy,
            },
          }
        : {}),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: landing.name[lang],
      serviceType: c.h1,
      provider: { '@type': 'LocalBusiness', '@id': businessId, name: site.name },
      areaServed: lang === 'ru' ? 'Киев и Украина' : 'Київ та Україна',
      ...(workImg ? { image: workImgUrl } : {}),
      url: canonical,
    };

const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: c.crumbHome, item: new URL(homeHref, site.url).href },
    { '@type': 'ListItem', position: 2, name: c.h1, item: canonical },
  ],
};
---

<BaseLayout title={c.metaTitle} description={c.metaDescription} jsonLd={[mainLd, breadcrumbsLd]} hreflang={hreflang}>
  <section class="page-head page-head--slim">
    <div class="container">
      <nav class="crumbs"><a href={homeHref}>{c.crumbHome}</a> / <span>{c.h1}</span></nav>
      <h1>{c.h1}</h1>
      <p class="landing-lead" set:html={c.lead}></p>
    </div>
  </section>

  <section class="section">
    <div class="container landing-body">
      {workImg && (
        <figure class="landing-work">
          <Image src={workImg} alt={imgAlt} widths={[480, 760, 1080]} sizes="(max-width: 820px) 100vw, 820px" loading="eager" />
          <figcaption>{imgAlt}</figcaption>
        </figure>
      )}

      {id === 'sportzalPk' && <GymHook />}

      {c.sections.map((s) => (
        <div class="landing-sec">
          <h2>{s.h2}</h2>
          <div set:html={s.body}></div>
        </div>
      ))}

      <div class="landing-cta">
        <h2>{c.ctaTitle}</h2>
        <p>{c.ctaText}</p>
        <div class="landing-cta__actions">
          <a href="#zayavka" class="btn btn--primary">{lang === 'ru' ? 'Оставить заявку' : 'Залишити заявку'}</a>
          {site.phones.map((p) => (<a href={`tel:${p.tel}`} class="btn btn--ghost">☎ {p.display}</a>))}
        </div>
      </div>
    </div>
  </section>

  <Faq items={c.faq} heading={c.faqHeading} soft={true} />

  <CallbackForm />
</BaseLayout>

<style>
  .page-head--slim { padding: clamp(24px, 4vw, 40px) 0; background: var(--bg-soft); }
  .crumbs { font-size: 0.88rem; color: var(--muted); margin-bottom: 0.8rem; }
  .crumbs a { color: var(--ink-soft); }
  .landing-lead { font-size: 1.15rem; color: var(--ink); max-width: 70ch; margin-top: 0.6rem; }
  .landing-body { max-width: 820px; }
  .landing-work { margin: 0 0 2rem; }
  .landing-work img { width: 100%; height: auto; max-height: 620px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); }
  .landing-work figcaption { margin-top: 0.5rem; font-size: 0.88rem; color: var(--muted); }
  .landing-sec { margin-bottom: 1.8rem; }
  .landing-sec h2 { font-family: var(--serif); color: var(--ink); font-size: 1.4rem; margin-bottom: 0.5rem; }
  .landing-sec :global(p) { color: var(--ink-soft); margin: 0 0 0.8rem; }
  .landing-sec :global(ul) { color: var(--ink-soft); margin: 0 0 0.8rem; padding-left: 1.2rem; }
  .landing-sec :global(li) { margin-bottom: 0.35rem; }
  .landing-sec :global(a) { color: var(--accent-dark); font-weight: 500; }
  .landing-sec :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 1rem; font-size: 0.98rem; }
  .landing-sec :global(th), .landing-sec :global(td) { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .landing-sec :global(th) { color: var(--ink); font-weight: 700; background: var(--bg-soft); }
  .landing-cta { margin-top: 2rem; padding: 24px 26px; background: var(--accent-soft); border-radius: var(--radius); }
  .landing-cta h2 { font-family: var(--serif); font-size: 1.3rem; margin-bottom: 0.4rem; }
  .landing-cta p { color: var(--ink-soft); margin-bottom: 1rem; }
  .landing-cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CallbackForm from '../CallbackForm.astro';
import { site } from '../../data/site';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const servicesByLang = {
  uk: [
    { title: 'Виготовлення дзеркал', text: 'Дзеркала будь-якої форми та розміру за вашими ескізами — прямокутні, круглі, овальні, фігурні, з вирізами. Скло 4–6 мм, виготовлення від 1 дня.', link: '/statti/dzerkala-na-zamovlennya-v-kievi/', more: 'Детальніше' },
    { title: 'Порізка дзеркала за розміром', text: 'Ріжемо дзеркало точно за вашими розмірами та свердлимо отвори під кріплення. Є термінова прирізка — від 1 дня.', link: '/statti/dzerkalo-za-rozmirom-na-zamovlennya-kiyiv/', more: 'Прайс за розмірами' },
    { title: 'Обробка кромки та фацет', text: 'Шліфування й поліровка кромки (єврокромка), фацет 10 і 15 мм — безпечний і елегантний край. Свердління під фурнітуру.', link: '/katalog/dzerkala-z-fatsetom/', more: 'Дзеркала з фацетом' },
    { title: 'LED-підсвітка', text: 'Інтеграція світлодіодної підсвітки: сенсорний вмикач, димер, регулювання температури світла та антизапотівання.', link: '/led-dzerkala-na-zamovlennya/', more: 'LED-дзеркала' },
    { title: 'Заміри', text: 'Безкоштовний виїзд майстра на об’єкт (при замовленні), точні заміри та консультація щодо оптимального рішення. Київ і область.' },
    { title: 'Монтаж дзеркал', text: 'Професійна установка дзеркал, плитки та панно на стіни й стелі. Безпечне кріплення великих полотен на антиосколкову плівку.', link: '/dzerkala-dlya-sportzalu-pid-klyuch/', more: 'Дзеркальні стіни під ключ' },
    { title: 'Доставка', text: 'Доставка Новою Поштою по всій Україні з надійним пакуванням або власним авто в Києві та області.' },
    { title: 'Демонтаж', text: 'Акуратний демонтаж старих дзеркал і дзеркальних конструкцій без пошкодження стін.' },
    { title: 'Заміна дзеркала', text: 'Заміна пошкодженого чи застарілого дзеркала — у наявній рамі або на місці, швидко й акуратно.' },
  ],
  ru: [
    { title: 'Изготовление зеркал', text: 'Зеркала любой формы и размера по вашим эскизам — прямоугольные, круглые, овальные, фигурные, с вырезами. Стекло 4–6 мм, изготовление от 1 дня.', link: '/ru/statti/dzerkala-na-zamovlennya-v-kievi/', more: 'Подробнее' },
    { title: 'Порезка зеркала по размеру', text: 'Режем зеркало точно по вашим размерам и сверлим отверстия под крепление. Есть срочная порезка — от 1 дня.', link: '/ru/statti/dzerkalo-za-rozmirom-na-zamovlennya-kiyiv/', more: 'Прайс по размерам' },
    { title: 'Обработка кромки и фацет', text: 'Шлифовка и полировка кромки (еврокромка), фацет 10 и 15 мм — безопасный и элегантный край. Сверление под фурнитуру.', link: '/ru/katalog/dzerkala-z-fatsetom/', more: 'Зеркала с фацетом' },
    { title: 'LED-подсветка', text: 'Интеграция светодиодной подсветки: сенсорный выключатель, диммер, регулировка температуры света и антизапотевание.', link: '/ru/led-zerkala-na-zakaz/', more: 'LED-зеркала' },
    { title: 'Замеры', text: 'Бесплатный выезд мастера на объект (при заказе), точные замеры и консультация по оптимальному решению. Киев и область.' },
    { title: 'Монтаж зеркал', text: 'Профессиональная установка зеркал, плитки и панно на стены и потолки. Безопасное крепление больших полотен на антиосколочную плёнку.', link: '/ru/zerkala-dlya-sportzala-pod-klyuch/', more: 'Зеркальные стены под ключ' },
    { title: 'Доставка', text: 'Доставка Новой Почтой по всей Украине с надёжной упаковкой или своим авто в Киеве и области.' },
    { title: 'Демонтаж', text: 'Аккуратный демонтаж старых зеркал и зеркальных конструкций без повреждения стен.' },
    { title: 'Замена зеркала', text: 'Замена повреждённого или устаревшего зеркала — в имеющейся раме или на месте, быстро и аккуратно.' },
  ],
};

const processByLang = {
  uk: [
    { n: '01', title: 'Заявка', text: 'Ви залишаєте заявку або телефонуєте — обговорюємо завдання й підбираємо рішення.' },
    { n: '02', title: 'Заміри', text: 'Майстер виїжджає на об’єкт, знімає точні розміри та консультує.' },
    { n: '03', title: 'Виготовлення', text: 'Ріжемо й обробляємо дзеркало за вашими розмірами на власному виробництві — від 1 дня.' },
    { n: '04', title: 'Монтаж', text: 'Доставляємо й встановлюємо власною бригадою — чисто, акуратно, надійно.' },
  ],
  ru: [
    { n: '01', title: 'Заявка', text: 'Вы оставляете заявку или звоните — обсуждаем задачу и подбираем решение.' },
    { n: '02', title: 'Замеры', text: 'Мастер выезжает на объект, снимает точные размеры и консультирует.' },
    { n: '03', title: 'Изготовление', text: 'Режем и обрабатываем зеркало по вашим размерам на собственном производстве — от 1 дня.' },
    { n: '04', title: 'Монтаж', text: 'Доставляем и устанавливаем собственной бригадой — чисто, аккуратно, надёжно.' },
  ],
};

const trustByLang = {
  uk: ['Власне виробництво з 2011', 'Заміри та монтаж власною бригадою', 'Виготовлення від 1 дня', 'Гарантія на роботу', 'Доставка НП по Україні'],
  ru: ['Собственное производство с 2011', 'Замеры и монтаж своей бригадой', 'Изготовление от 1 дня', 'Гарантия на работу', 'Доставка НП по Украине'],
};

const process = processByLang[lang] ?? processByLang.uk;
const trust = trustByLang[lang] ?? trustByLang.uk;
const processHeading = lang === 'ru' ? 'Как мы работаем' : 'Як ми працюємо';

const faqByLang = {
  uk: [
    { q: 'Скільки коштує дзеркало на замовлення?', a: 'Вартість залежить від розміру, товщини, типу обробки кромки та додаткових опцій (підсвітка, антизапотівання). Точну ціну називаємо після замірів — прорахунок безкоштовний.' },
    { q: 'Скільки часу займає виготовлення?', a: 'Стандартні замовлення виготовляємо за 2–5 робочих днів. Складні панно та великі проєкти — за індивідуальним графіком.' },
    { q: 'Чи виконуєте монтаж?', a: 'Так, ми робимо повний цикл «під ключ»: заміри, виготовлення, доставку та професійний монтаж власною бригадою.' },
    { q: 'У яких районах Києва ви працюєте?', a: 'Працюємо по всьому Києву та області (Ірпінь, Буча, Вишневе, Бровари, Бориспіль). Виїзд на заміри узгоджуємо за телефоном.' },
    { q: 'Чи ріжете просто скло?', a: 'Ми спеціалізуємось на дзеркалах: ріжемо й обробляємо дзеркало за вашим розміром. Порізку звичайного віконного скла не виконуємо.' },
    { q: 'Чи є доставка в інші міста?', a: 'Так, готові дзеркала відправляємо Новою Поштою по всій Україні; заміри та монтаж — у Києві та області.' },
    { q: 'Чи даєте гарантію?', a: 'Так, надаємо гарантію на виготовлення й монтаж. Використовуємо якісне вологостійке скло та надійну фурнітуру.' },
  ],
  ru: [
    { q: 'Сколько стоит зеркало на заказ?', a: 'Стоимость зависит от размера, толщины, типа обработки кромки и дополнительных опций (подсветка, антизапотевание). Точную цену называем после замеров — просчёт бесплатный.' },
    { q: 'Сколько времени занимает изготовление?', a: 'Стандартные заказы изготавливаем за 2–5 рабочих дней. Сложные панно и крупные проекты — по индивидуальному графику.' },
    { q: 'Выполняете ли монтаж?', a: 'Да, мы делаем полный цикл «под ключ»: замеры, изготовление, доставку и профессиональный монтаж собственной бригадой.' },
    { q: 'В каких районах Киева вы работаете?', a: 'Работаем по всему Киеву и области (Ирпень, Буча, Вишнёвое, Бровары, Борисполь). Выезд на замеры согласовываем по телефону.' },
    { q: 'Вы режете просто стекло?', a: 'Мы специализируемся на зеркалах: режем и обрабатываем зеркало по вашему размеру. Порезку обычного оконного стекла не выполняем.' },
    { q: 'Есть ли доставка в другие города?', a: 'Да, готовые зеркала отправляем Новой Почтой по всей Украине; замеры и монтаж — в Киеве и области.' },
    { q: 'Даёте ли гарантию?', a: 'Да, предоставляем гарантию на изготовление и монтаж. Используем качественное влагостойкое стекло и надёжную фурнитуру.' },
  ],
};

const services = servicesByLang[lang] ?? servicesByLang.uk;
const faq = faqByLang[lang] ?? faqByLang.uk;
const base = localizePath('/', lang);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: lang === 'ru' ? 'Изготовление и монтаж зеркал на заказ' : 'Виготовлення та монтаж дзеркал на замовлення',
  provider: { '@type': 'LocalBusiness', '@id': `${site.url}/#business` },
  areaServed: lang === 'ru' ? 'Киев и область' : 'Київ та область',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t('services.title'),
    itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title } })),
  },
};
---

<BaseLayout title={t('services.metaTitle')} description={t('services.intro')} jsonLd={[faqLd, serviceLd]}>
  <section class="page-head">
    <div class="container">
      <nav class="crumbs"><a href={base}>{t('nav.home')}</a> / <span>{t('services.title')}</span></nav>
      <h1>{t('services.title')}</h1>
      <p>{t('services.intro')}</p>
      <ul class="trust-strip">
        {trust.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {services.map((s) => (
          <div class="svc">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {s.link && <a class="svc__link link-arrow" href={s.link}>{s.more}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">{lang === 'ru' ? 'Процесс' : 'Процес'}</span>
        <h2>{processHeading}</h2>
      </div>
      <div class="grid grid--4">
        {process.map((p) => (
          <div class="step">
            <span class="step__n">{p.n}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">{t('services.faqEyebrow')}</span>
        <h2>{t('services.faqHeading')}</h2>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <CallbackForm />
</BaseLayout>

<style>
  .page-head { padding: clamp(16px, 2vw, 26px) 0; background: var(--bg-soft); }
  .crumbs { font-size: 0.88rem; color: var(--muted); margin-bottom: 1rem; }
  .crumbs a { color: var(--ink-soft); }
  .page-head p { color: var(--ink-soft); max-width: 60ch; font-size: 1.08rem; }
  .trust-strip { list-style: none; padding: 0; margin: 1.2rem 0 0; display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .trust-strip li { position: relative; padding-left: 22px; font-size: 0.9rem; color: var(--ink-soft); font-weight: 500; }
  .trust-strip li::before { content: '✓'; position: absolute; left: 0; color: var(--accent-dark); font-weight: 700; }
  .svc { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px 24px; display: flex; flex-direction: column; }
  .svc h3 { font-size: 1.2rem; }
  .svc p { color: var(--ink-soft); font-size: 0.97rem; margin: 0; flex: 1; }
  .svc__link { margin-top: 0.9rem; }
  .step { position: relative; padding-top: 8px; }
  .step__n { font-family: var(--serif); font-size: 2.6rem; font-weight: 700; color: var(--accent); opacity: 0.5; display: block; line-height: 1; }
  .step h3 { margin-top: 0.6rem; font-size: 1.2rem; }
  .step p { color: var(--ink-soft); font-size: 0.96rem; }
  .faq { max-width: 800px; margin-inline: auto; display: grid; gap: 12px; }
  .faq__item { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 4px 22px; }
  .faq__item summary { cursor: pointer; font-weight: 600; padding: 16px 0; list-style: none; font-size: 1.05rem; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; float: right; color: var(--accent); font-size: 1.4rem; line-height: 1; }
  .faq__item[open] summary::after { content: '−'; }
  .faq__item p { color: var(--ink-soft); padding-bottom: 18px; margin: 0; }
</style>

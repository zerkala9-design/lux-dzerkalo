---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../ProductCard.astro';
import CallbackForm from '../CallbackForm.astro';
import GymHook from '../GymHook.astro';
import { site } from '../../data/site';
import { getCategory, catTitle } from '../../data/categories';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';
import { getProductsByLang, productSlug, type Product } from '../../lib/products';
import { offerShippingDetails, merchantReturnPolicy } from '../../lib/schema';

interface Props { product: Product; }
const { product } = Astro.props;
const { data } = product;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(product);
const category = getCategory(data.category);
const base = localizePath('/', lang);

const related = (await getProductsByLang(lang))
  .filter((p) => p.data.category === data.category && p.id !== product.id)
  .slice(0, 3);

const gallery = [data.image, ...(data.gallery ?? [])];

// Конфігуратор ціни показуємо лише коли є опції й точна базова ціна
const showConfig = !!data.options && !!data.priceFrom && data.priceExact;
const orderLabel = lang === 'ru' ? 'Заказать' : 'Замовити';
const cfg = lang === 'ru'
  ? { heading: 'Соберите комплектацию', film: 'Плёнка безопасности', mount: 'Крепление', none: 'Без крепления',
      mProfile: 'Профиль снизу', mPoint: 'Точечное сверху', delivery: 'Доставка', pickup: 'Самовывоз, Киев',
      free: 'бесплатно', np: 'Новая Почта', from: 'от', byCity: 'зависит от города', kyiv: 'Доставка по Киеву', total: 'Итого' }
  : { heading: 'Зберіть комплектацію', film: 'Плівка безпеки', mount: 'Кріплення', none: 'Без кріплення',
      mProfile: 'Профіль знизу', mPoint: 'Точкове зверху', delivery: 'Доставка', pickup: 'Самовивіз, Київ',
      free: 'безкоштовно', np: 'Нова Пошта', from: 'від', byCity: 'залежно від міста', kyiv: 'Доставка по Києву', total: 'Разом' };

// getImage гарантує емітований JPEG (data.image.src може вести на неемітований оригінал → 404).
const schemaImg = await getImage({ src: data.image, format: 'jpeg', width: 1200 });

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.title,
  description: data.summary,
  image: new URL(schemaImg.src, site.url).href,
  brand: { '@type': 'Brand', name: site.name },
  ...(data.priceFrom
    ? {
        offers: {
          '@type': 'Offer',
          price: data.priceFrom,
          priceCurrency: 'UAH',
          availability: 'https://schema.org/InStock',
          itemCondition: 'https://schema.org/NewCondition',
          url: new URL(localizePath(`/tovar/${productSlug(product)}/`, lang), site.url).href,
          shippingDetails: offerShippingDetails,
          hasMerchantReturnPolicy: merchantReturnPolicy,
        },
      }
    : {}),
};

const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: new URL(base, site.url).href },
    { '@type': 'ListItem', position: 2, name: t('catalog.title'), item: new URL(localizePath('/katalog/', lang), site.url).href },
    ...(category
      ? [{ '@type': 'ListItem', position: 3, name: catTitle(category, lang), item: new URL(localizePath(`/katalog/${category.slug}/`, lang), site.url).href }]
      : []),
    { '@type': 'ListItem', position: category ? 4 : 3, name: data.title, item: new URL(localizePath(`/tovar/${productSlug(product)}/`, lang), site.url).href },
  ],
};
---

<BaseLayout title={data.title} description={data.summary} jsonLd={[productLd, breadcrumbsLd]}>
  <section class="page-head page-head--slim">
    <div class="container">
      <nav class="crumbs">
        <a href={base}>{t('nav.home')}</a> / <a href={localizePath('/katalog/', lang)}>{t('catalog.title')}</a>
        {category && <> / <a href={localizePath(`/katalog/${category.slug}/`, lang)}>{catTitle(category, lang)}</a></>}
        / <span>{data.title}</span>
      </nav>
    </div>
  </section>

  <section class="section product">
    <div class="container product__grid">
      <div class="product__gallery">
        <div class="product__main">
          <Image src={data.image} alt={data.title} width={820} densities={[1, 2]} id="main-image" />
        </div>
        {gallery.length > 1 && (
          <div class="product__thumbs">
            {gallery.map((img, i) => (
              <button class:list={['thumb', { active: i === 0 }]} data-src={img.src} aria-label={`${data.title} ${i + 1}`}>
                <Image src={img} alt={`${data.title} — ${i + 1}`} width={160} height={120} densities={[1, 2]} />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="product__info">
        {category && <a href={localizePath(`/katalog/${category.slug}/`, lang)} class="eyebrow">{catTitle(category, lang)}</a>}
        <h1>{data.title}</h1>
        <p class="product__summary">{data.summary}</p>

        <div class="product__price">
          {data.priceFrom ? (
            data.priceExact ? (
              <><strong>{lang === 'ru' ? 'Цена' : 'Ціна'} {data.priceFrom} {data.priceUnit}</strong>
              <span class="product__instock">✔ {lang === 'ru' ? 'В наличии' : 'В наявності'}</span></>
            ) : (
              <><strong>{t('common.priceFrom')} {data.priceFrom} {data.priceUnit}</strong>
              <span>{t('product.priceNote')}</span></>
            )
          ) : (
            <strong>{t('common.priceRequest')}</strong>
          )}
          <div class="product__price-actions">
            <a href="#zayavka" class="btn btn--primary" data-order-btn data-product={data.title}>{orderLabel}</a>
          </div>
        </div>

        {showConfig && (
          <div class="product__config" data-base={data.priceFrom} data-unit={data.priceUnit}>
            <h3 class="cfg__h">{cfg.heading}</h3>
            {data.options!.film && (
              <label class="cfg-opt">
                <input type="checkbox" name="film" data-add={data.options!.film} value={cfg.film} />
                <span>{cfg.film} <b class="cfg-add">+{data.options!.film} {data.priceUnit}</b></span>
              </label>
            )}
            {(data.options!.mountProfile || data.options!.mountPoint) && (
              <fieldset class="cfg-group">
                <legend>{cfg.mount}</legend>
                <label class="cfg-opt"><input type="radio" name="mount" data-add="0" value="" checked /><span>{cfg.none}</span></label>
                {data.options!.mountProfile && (
                  <label class="cfg-opt"><input type="radio" name="mount" data-add={data.options!.mountProfile} value={cfg.mProfile} /><span>{cfg.mProfile} <b class="cfg-add">+{data.options!.mountProfile} {data.priceUnit}</b></span></label>
                )}
                {data.options!.mountPoint && (
                  <label class="cfg-opt"><input type="radio" name="mount" data-add={data.options!.mountPoint} value={cfg.mPoint} /><span>{cfg.mPoint} <b class="cfg-add">+{data.options!.mountPoint} {data.priceUnit}</b></span></label>
                )}
              </fieldset>
            )}
            <fieldset class="cfg-group">
              <legend>{cfg.delivery}</legend>
              <label class="cfg-opt"><input type="radio" name="delivery" data-add="0" value={cfg.pickup} checked /><span>{cfg.pickup} <b class="cfg-free">{cfg.free}</b></span></label>
              {data.options!.deliveryKyiv && (
                <label class="cfg-opt"><input type="radio" name="delivery" data-add={data.options!.deliveryKyiv} value={cfg.kyiv} /><span>{cfg.kyiv} <b class="cfg-add">+{data.options!.deliveryKyiv} {data.priceUnit}</b></span></label>
              )}
              {data.options!.deliveryNPfrom && (
                <label class="cfg-opt"><input type="radio" name="delivery" data-add="0" value={`${cfg.np} (${cfg.from} ${data.options!.deliveryNPfrom} ${data.priceUnit})`} /><span>{cfg.np} <b class="cfg-note">{cfg.from} {data.options!.deliveryNPfrom} {data.priceUnit}, {cfg.byCity}</b></span></label>
              )}
            </fieldset>
            <div class="cfg-total"><span>{cfg.total}:</span> <strong data-total>{data.priceFrom} {data.priceUnit}</strong></div>
          </div>
        )}

        {data.specs.length > 0 && (
          <table class="product__specs">
            <caption>{lang === 'ru' ? 'Характеристики' : 'Характеристики'}</caption>
            <tbody>
              {data.specs.map((s) => (
                <tr><th scope="row">{s.label}</th><td>{s.value}</td></tr>
              ))}
            </tbody>
          </table>
        )}

        {data.features.length > 0 && (
          <ul class="product__features">
            {data.features.map((f) => <li>{f}</li>)}
          </ul>
        )}

        {data.category === 'sportzal' && <GymHook />}

        <div class="product__actions">
          <a href="#zayavka" class="btn btn--primary" data-order-btn data-product={data.title}>{t('product.order')}</a>
          <a href={`tel:${site.phones[0].tel}`} class="btn btn--ghost">☎ {site.phones[0].display}</a>
        </div>

        <div class="product__desc">
          <Content />
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <div class="section-head"><span class="eyebrow">{t('product.similar')}</span><h2>{t('product.alsoCategory')}</h2></div>
        <div class="grid grid--3">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}

  <CallbackForm />
</BaseLayout>

<style>
  .page-head--slim { padding: clamp(24px, 4vw, 36px) 0; background: var(--bg-soft); }
  .crumbs { font-size: 0.88rem; color: var(--muted); }
  .crumbs a { color: var(--ink-soft); }
  .product__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: start; }
  .product__gallery { position: sticky; top: 88px; align-self: start; }
  .product__main { border-radius: var(--radius); overflow: hidden; background: var(--bg-soft); border: 1px solid var(--line); }
  .product__main img { width: 100%; height: auto; object-fit: cover; }
  .product__thumbs { display: flex; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .thumb { width: 90px; height: 70px; border-radius: var(--radius-sm); overflow: hidden; border: 2px solid var(--line); padding: 0; cursor: pointer; background: none; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb.active { border-color: var(--accent); }
  .product__summary { font-size: 1.1rem; color: var(--ink-soft); }
  .product__price { display: flex; flex-direction: column; gap: 2px; margin: 1.2rem 0; padding: 1rem 1.2rem; background: var(--accent-soft); border-radius: var(--radius-sm); }
  .product__price strong { font-family: var(--serif); font-size: 1.5rem; color: var(--ink); }
  .product__price span { font-size: 0.85rem; color: var(--ink-soft); }
  .product__instock { color: #188038 !important; font-weight: 600; }
  .product__price-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 0.9rem; }
  .product__price-actions .btn { flex: 1; justify-content: center; min-width: 140px; }
  .product__config { border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; margin: 0 0 1.6rem; }
  .cfg__h { font-size: 1.1rem; margin: 0 0 0.9rem; }
  .cfg-group { border: 0; padding: 0; margin: 0 0 0.9rem; }
  .cfg-group legend { font-weight: 600; color: var(--ink-soft); font-size: 0.9rem; padding: 0; margin-bottom: 0.4rem; }
  .cfg-opt { display: flex; align-items: center; gap: 10px; padding: 7px 0; cursor: pointer; font-size: 0.96rem; }
  .cfg-opt input { width: 18px; height: 18px; accent-color: var(--accent); flex: none; cursor: pointer; }
  .cfg-add { color: var(--accent-dark); font-weight: 700; }
  .cfg-free { color: #188038; font-weight: 700; }
  .cfg-note { color: var(--muted); font-weight: 500; font-size: 0.85rem; }
  .cfg-total { border-top: 1px solid var(--line); margin-top: 0.6rem; padding-top: 0.9rem; display: flex; align-items: baseline; justify-content: space-between; }
  .cfg-total span { color: var(--ink-soft); font-weight: 600; }
  .cfg-total strong { font-family: var(--serif); font-size: 1.6rem; color: var(--ink); }
  .product__specs { width: 100%; border-collapse: collapse; margin: 0 0 1.4rem; font-size: 0.95rem; }
  .product__specs caption { text-align: left; font-weight: 700; color: var(--ink); margin-bottom: 0.5rem; font-size: 1.05rem; }
  .product__specs th, .product__specs td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .product__specs th { color: var(--ink-soft); font-weight: 500; width: 45%; }
  .product__specs td { color: var(--ink); font-weight: 600; }
  .product__features { list-style: none; padding: 0; margin: 0 0 1.6rem; display: grid; gap: 0.55rem; }
  .product__features li { padding-left: 28px; position: relative; }
  .product__features li::before { content: '✓'; position: absolute; left: 0; color: var(--accent-dark); font-weight: 700; }
  .product__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 2rem; }
  .product__desc { border-top: 1px solid var(--line); padding-top: 1.6rem; color: var(--ink-soft); }
  .product__desc :global(strong) { color: var(--ink); }
  @media (max-width: 860px) { .product__grid { grid-template-columns: 1fr; gap: 28px; } .product__gallery { position: static; } }
</style>

<script define:vars={{ orderPrefix: lang === 'ru' ? 'Хочу заказать: ' : 'Хочу замовити: ', deliveryWord: cfg.delivery, totalWord: cfg.total }}>
  const main = document.getElementById('main-image');
  const thumbs = document.querySelectorAll('.thumb');
  thumbs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const img = btn.querySelector('img');
      if (main && img) { main.src = img.currentSrc || img.src; main.removeAttribute('srcset'); }
      thumbs.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // Конфігуратор ціни: живий підрахунок суми.
  const config = document.querySelector('.product__config');
  const fmt = (n) => n;
  function calcTotal() {
    if (!config) return null;
    const base = Number(config.getAttribute('data-base')) || 0;
    const unit = config.getAttribute('data-unit') || 'грн';
    let sum = base;
    config.querySelectorAll('input:checked').forEach((i) => { sum += Number(i.getAttribute('data-add')) || 0; });
    const totalEl = config.querySelector('[data-total]');
    if (totalEl) totalEl.textContent = fmt(sum) + ' ' + unit;
    return sum;
  }
  if (config) { config.addEventListener('change', calcTotal); calcTotal(); }

  // Кнопка «Замовити» → підставляє назву товару + вибрану комплектацію й суму в заявку.
  document.querySelectorAll('[data-order-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const msg = document.querySelector('#callback-form textarea[name="message"]');
      const product = btn.getAttribute('data-product') || '';
      if (!msg || !product) return;
      const lines = [orderPrefix + product];
      if (config) {
        const film = config.querySelector('input[name="film"]');
        if (film && film.checked) lines.push('+ ' + film.value);
        const mount = config.querySelector('input[name="mount"]:checked');
        if (mount && mount.value) lines.push('+ ' + mount.value);
        const del = config.querySelector('input[name="delivery"]:checked');
        if (del && del.value) lines.push(deliveryWord + ': ' + del.value);
        const total = config.querySelector('[data-total]');
        if (total) lines.push(totalWord + ': ' + total.textContent);
      }
      if (!msg.value.trim()) msg.value = lines.join('\n');
    });
  });
</script>

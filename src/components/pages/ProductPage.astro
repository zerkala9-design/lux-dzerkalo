---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../ProductCard.astro';
import CallbackForm from '../CallbackForm.astro';
import { site } from '../../data/site';
import { getCategory, catTitle } from '../../data/categories';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui';
import { getProductsByLang, productSlug, type Product } from '../../lib/products';
import { offerShippingDetails, merchantReturnPolicy } from '../../lib/schema';

interface Props { product: Product; }
const { product } = Astro.props;
const { data } = product;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(product);
const category = getCategory(data.category);
const base = localizePath('/', lang);

const related = (await getProductsByLang(lang))
  .filter((p) => p.data.category === data.category && p.id !== product.id)
  .slice(0, 3);

const gallery = [data.image, ...(data.gallery ?? [])];

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.title,
  description: data.summary,
  image: new URL(data.image.src, site.url).href,
  brand: { '@type': 'Brand', name: site.name },
  ...(data.priceFrom
    ? {
        offers: {
          '@type': 'Offer',
          price: data.priceFrom,
          priceCurrency: 'UAH',
          availability: 'https://schema.org/InStock',
          itemCondition: 'https://schema.org/NewCondition',
          url: new URL(localizePath(`/tovar/${productSlug(product)}/`, lang), site.url).href,
          shippingDetails: offerShippingDetails,
          hasMerchantReturnPolicy: merchantReturnPolicy,
        },
      }
    : {}),
};

const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: new URL(base, site.url).href },
    { '@type': 'ListItem', position: 2, name: t('catalog.title'), item: new URL(localizePath('/katalog/', lang), site.url).href },
    ...(category
      ? [{ '@type': 'ListItem', position: 3, name: catTitle(category, lang), item: new URL(localizePath(`/katalog/${category.slug}/`, lang), site.url).href }]
      : []),
    { '@type': 'ListItem', position: category ? 4 : 3, name: data.title, item: new URL(localizePath(`/tovar/${productSlug(product)}/`, lang), site.url).href },
  ],
};
---

<BaseLayout title={data.title} description={data.summary} jsonLd={[productLd, breadcrumbsLd]}>
  <section class="page-head page-head--slim">
    <div class="container">
      <nav class="crumbs">
        <a href={base}>{t('nav.home')}</a> / <a href={localizePath('/katalog/', lang)}>{t('catalog.title')}</a>
        {category && <> / <a href={localizePath(`/katalog/${category.slug}/`, lang)}>{catTitle(category, lang)}</a></>}
        / <span>{data.title}</span>
      </nav>
    </div>
  </section>

  <section class="section product">
    <div class="container product__grid">
      <div class="product__gallery">
        <div class="product__main">
          <Image src={data.image} alt={data.title} width={820} densities={[1, 2]} id="main-image" />
        </div>
        {gallery.length > 1 && (
          <div class="product__thumbs">
            {gallery.map((img, i) => (
              <button class:list={['thumb', { active: i === 0 }]} data-src={img.src} aria-label={`${data.title} ${i + 1}`}>
                <Image src={img} alt={`${data.title} — ${i + 1}`} width={160} height={120} densities={[1, 2]} />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="product__info">
        {category && <a href={localizePath(`/katalog/${category.slug}/`, lang)} class="eyebrow">{catTitle(category, lang)}</a>}
        <h1>{data.title}</h1>
        <p class="product__summary">{data.summary}</p>

        <div class="product__price">
          {data.priceFrom ? (
            data.priceExact ? (
              <><strong>{data.priceFrom.toLocaleString('uk-UA')} {data.priceUnit}</strong>
              <span class="product__instock">✔ {lang === 'ru' ? 'В наличии' : 'В наявності'}</span></>
            ) : (
              <><strong>{t('common.priceFrom')} {data.priceFrom.toLocaleString('uk-UA')} {data.priceUnit}</strong>
              <span>{t('product.priceNote')}</span></>
            )
          ) : (
            <strong>{t('common.priceRequest')}</strong>
          )}
        </div>

        {data.specs.length > 0 && (
          <table class="product__specs">
            <caption>{lang === 'ru' ? 'Характеристики' : 'Характеристики'}</caption>
            <tbody>
              {data.specs.map((s) => (
                <tr><th scope="row">{s.label}</th><td>{s.value}</td></tr>
              ))}
            </tbody>
          </table>
        )}

        {data.features.length > 0 && (
          <ul class="product__features">
            {data.features.map((f) => <li>{f}</li>)}
          </ul>
        )}

        <div class="product__actions">
          <a href="#zayavka" class="btn btn--primary">{t('product.order')}</a>
          <a href={`tel:${site.phones[0].tel}`} class="btn btn--ghost">☎ {site.phones[0].display}</a>
        </div>

        <div class="product__desc">
          <Content />
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <div class="section-head"><span class="eyebrow">{t('product.similar')}</span><h2>{t('product.alsoCategory')}</h2></div>
        <div class="grid grid--3">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}

  <CallbackForm />
</BaseLayout>

<style>
  .page-head--slim { padding: clamp(24px, 4vw, 36px) 0; background: var(--bg-soft); }
  .crumbs { font-size: 0.88rem; color: var(--muted); }
  .crumbs a { color: var(--ink-soft); }
  .product__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: start; }
  .product__main { border-radius: var(--radius); overflow: hidden; background: var(--bg-soft); border: 1px solid var(--line); }
  .product__main img { width: 100%; height: auto; object-fit: cover; }
  .product__thumbs { display: flex; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .thumb { width: 90px; height: 70px; border-radius: var(--radius-sm); overflow: hidden; border: 2px solid var(--line); padding: 0; cursor: pointer; background: none; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb.active { border-color: var(--accent); }
  .product__summary { font-size: 1.1rem; color: var(--ink-soft); }
  .product__price { display: flex; flex-direction: column; gap: 2px; margin: 1.2rem 0; padding: 1rem 1.2rem; background: var(--accent-soft); border-radius: var(--radius-sm); }
  .product__price strong { font-family: var(--serif); font-size: 1.5rem; color: var(--ink); }
  .product__price span { font-size: 0.85rem; color: var(--ink-soft); }
  .product__instock { color: #188038 !important; font-weight: 600; }
  .product__specs { width: 100%; border-collapse: collapse; margin: 0 0 1.4rem; font-size: 0.95rem; }
  .product__specs caption { text-align: left; font-weight: 700; color: var(--ink); margin-bottom: 0.5rem; font-size: 1.05rem; }
  .product__specs th, .product__specs td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .product__specs th { color: var(--ink-soft); font-weight: 500; width: 45%; }
  .product__specs td { color: var(--ink); font-weight: 600; }
  .product__features { list-style: none; padding: 0; margin: 0 0 1.6rem; display: grid; gap: 0.55rem; }
  .product__features li { padding-left: 28px; position: relative; }
  .product__features li::before { content: '✓'; position: absolute; left: 0; color: var(--accent-dark); font-weight: 700; }
  .product__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 2rem; }
  .product__desc { border-top: 1px solid var(--line); padding-top: 1.6rem; color: var(--ink-soft); }
  .product__desc :global(strong) { color: var(--ink); }
  @media (max-width: 860px) { .product__grid { grid-template-columns: 1fr; gap: 28px; } }
</style>

<script>
  const main = document.getElementById('main-image') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.thumb');
  thumbs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const img = btn.querySelector('img');
      if (main && img) { main.src = img.currentSrc || img.src; main.removeAttribute('srcset'); }
      thumbs.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });
</script>

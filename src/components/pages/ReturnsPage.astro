---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { getLangFromUrl, localizePath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const base = localizePath('/', lang);

const t = lang === 'ru'
  ? {
      title: 'Условия возврата и обмена',
      metaTitle: 'Условия возврата и обмена — Lux Dzerkalo',
      metaDesc: 'Условия возврата и обмена зеркал Lux Dzerkalo: изделия на заказ, готовые товары, товар ненадлежащего качества, порядок оформления. Киев, доставка по Украине.',
      home: 'Главная',
      intro: `Продавец — Lux Dzerkalo (ФЛП Бричков М.Р.), г. Киев. Мы работаем в соответствии с Законом Украины «О защите прав потребителей». Ниже — условия возврата и обмена товара.`,
      blocks: [
        { h: '1. Изделия, изготовленные на заказ', p: 'Зеркала, изготовленные по индивидуальным размерам, форме или с индивидуальными опциями (подсветка, фацет, отверстия и т. п.) являются товаром, изготовленным по индивидуальному заказу. Такой товар <strong>надлежащего качества</strong> обмену и возврату <strong>не подлежит</strong> (ст. 9 Закона Украины «О защите прав потребителей»), так как имеет индивидуально-определённые свойства.' },
        { h: '2. Готовые (складские) товары надлежащего качества', p: 'Готовый товар из наличия, который не изготавливался по индивидуальному заказу, можно вернуть или обменять в течение <strong>14 дней</strong> с момента получения при условии: товар не был в использовании, сохранены товарный вид, потребительские свойства, упаковка, пломбы и ярлыки. Возврат осуществляется при наличии расчётного документа.' },
        { h: '3. Товар ненадлежащего качества', p: 'Если товар имеет производственный дефект или повреждён при доставке — мы <strong>заменяем его или возвращаем средства</strong>. Пожалуйста, осмотрите изделие при получении и сообщите о повреждении в течение <strong>24 часов</strong>, приложив фото. Расходы на замену/возврат некачественного товара берёт на себя продавец.' },
        { h: '4. Как оформить возврат', p: 'Свяжитесь с нами по телефону или в мессенджере, сообщите номер заказа и причину. Мы согласуем порядок возврата или замены. Зеркало — хрупкий товар, поэтому упаковку и способ отправки согласовываем отдельно.' },
        { h: '5. Возврат средств', p: 'Средства возвращаются тем же способом, которым была произведена оплата, после получения и проверки товара — обычно в течение нескольких рабочих дней.' },
      ],
      contactsH: 'Контакты для возврата',
    }
  : {
      title: 'Умови повернення та обміну',
      metaTitle: 'Умови повернення та обміну — Lux Dzerkalo',
      metaDesc: 'Умови повернення та обміну дзеркал Lux Dzerkalo: вироби на замовлення, готові товари, товар неналежної якості, порядок оформлення. Київ, доставка по Україні.',
      home: 'Головна',
      intro: `Продавець — Lux Dzerkalo (ФОП Бричков М.Р.), м. Київ. Ми працюємо відповідно до Закону України «Про захист прав споживачів». Нижче — умови повернення та обміну товару.`,
      blocks: [
        { h: '1. Вироби, виготовлені на замовлення', p: 'Дзеркала, виготовлені за індивідуальними розмірами, формою чи з індивідуальними опціями (підсвітка, фацет, отвори тощо) є товаром, виготовленим за індивідуальним замовленням. Такий товар <strong>належної якості</strong> обміну та поверненню <strong>не підлягає</strong> (ст. 9 Закону України «Про захист прав споживачів»), оскільки має індивідуально визначені властивості.' },
        { h: '2. Готові (складські) товари належної якості', p: 'Готовий товар із наявності, що не виготовлявся за індивідуальним замовленням, можна повернути або обміняти протягом <strong>14 днів</strong> з моменту отримання за умови: товар не був у використанні, збережено товарний вигляд, споживчі властивості, упаковку, пломби та ярлики. Повернення здійснюється за наявності розрахункового документа.' },
        { h: '3. Товар неналежної якості', p: 'Якщо товар має виробничий дефект або пошкоджений під час доставки — ми <strong>замінюємо його або повертаємо кошти</strong>. Будь ласка, огляньте виріб при отриманні й повідомте про пошкодження протягом <strong>24 годин</strong>, додавши фото. Витрати на заміну/повернення неякісного товару бере на себе продавець.' },
        { h: '4. Як оформити повернення', p: 'Зв\'яжіться з нами за телефоном або в месенджері, повідомте номер замовлення й причину. Ми узгодимо порядок повернення чи заміни. Дзеркало — крихкий товар, тому пакування та спосіб відправлення узгоджуємо окремо.' },
        { h: '5. Повернення коштів', p: 'Кошти повертаються тим самим способом, яким було здійснено оплату, після отримання й перевірки товару — зазвичай протягом кількох робочих днів.' },
      ],
      contactsH: 'Контакти для повернення',
    };
---

<BaseLayout title={t.title} description={t.metaDesc} noindex={false}>
  <section class="page-head">
    <div class="container">
      <nav class="crumbs"><a href={base}>{t.home}</a> / <span>{t.title}</span></nav>
      <h1>{t.title}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container policy">
      <p class="policy__intro">{t.intro}</p>
      {t.blocks.map((b) => (
        <div class="policy__block">
          <h2>{b.h}</h2>
          <p set:html={b.p}></p>
        </div>
      ))}
      <div class="policy__block">
        <h2>{t.contactsH}</h2>
        <p>
          {site.phones.map((p) => (<><a href={`tel:${p.tel}`}>{p.display}</a><br /></>))}
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          {site.address}, {lang === 'ru' ? 'Киев' : 'Київ'}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding: clamp(16px, 2vw, 26px) 0; background: var(--bg-soft); }
  .crumbs { font-size: 0.88rem; color: var(--muted); margin-bottom: 1rem; }
  .crumbs a { color: var(--ink-soft); }
  .policy { max-width: 820px; }
  .policy__intro { font-size: 1.08rem; color: var(--ink-soft); margin-bottom: 2rem; }
  .policy__block { margin-bottom: 1.6rem; }
  .policy__block h2 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .policy__block p { color: var(--ink-soft); margin: 0; }
  .policy__block :global(strong) { color: var(--ink); }
  .policy a { color: var(--accent-dark); font-weight: 600; }
</style>

---
import { site, navItems, siteText } from '../data/site';
import { categories, catTitle } from '../data/categories';
import { landings } from '../data/landings';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/ui';
import { getArticleSlugSets } from '../lib/articles';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const st = siteText(lang);

// Послуги (LLM/entity-лендінги) — сайт-широка перелінковка
const svcMeta = [
  { key: 'vyrobnyk', uk: 'Виробник дзеркал', ru: 'Производитель зеркал' },
  { key: 'sportzalPk', uk: 'Спортзали під ключ', ru: 'Спортзалы под ключ' },
  { key: 'led', uk: 'LED-дзеркала', ru: 'LED-зеркала' },
  { key: 'plitka', uk: 'Дзеркальна плитка', ru: 'Зеркальная плитка' },
  { key: 'paneli', uk: 'Дзеркальні панелі', ru: 'Зеркальные панели' },
  { key: 'kuhnya', uk: 'Дзеркало на кухню', ru: 'Зеркало на кухню' },
  { key: 'ofis', uk: 'Дзеркала для офісу', ru: 'Зеркала для офиса' },
  { key: 'tantszal', uk: 'Дзеркала для танцзалу', ru: 'Зеркала для танцзала' },
  { key: 'boksKrosfit', uk: 'Дзеркала для боксу', ru: 'Зеркала для бокса' },
  { key: 'yoga', uk: 'Дзеркала для йоги', ru: 'Зеркала для йоги' },
  { key: 'grymerne', uk: 'Гримерне дзеркало', ru: 'Гримёрное зеркало' },
];
const svcLinks = svcMeta.map((s) => ({
  label: lang === 'ru' ? s.ru : s.uk,
  href: lang === 'ru' ? `/ru/${landings[s.key].slugRu}/` : `/${landings[s.key].slugUk}/`,
}));
const svcHeading = lang === 'ru' ? 'Услуги' : 'Послуги';
const year = new Date().getFullYear();

// Перемикач мови: той самий шлях у протилежній мові
const current = Astro.url.pathname;
const stripped = current.replace(/^\/ru(\/|$)/, '/');
let altUk = stripped === '' ? '/' : stripped;
let altRu = altUk === '/' ? '/ru/' : `/ru${altUk}`;

// Не всі статті мають мовний двійник (частина легасі — лише RU).
// Щоб перемикач мови не вів на 404, за відсутності двійника ведемо на список статей тієї мови.
const artMatch = altUk.match(/^\/statti\/([^/]+)\/$/);
if (artMatch) {
  const slug = artMatch[1];
  const { uk, ru } = await getArticleSlugSets();
  if (!uk.has(slug)) altUk = '/statti/';
  if (!ru.has(slug)) altRu = '/ru/statti/';
}

const socials = [
  { name: 'Instagram', url: site.social.instagram },
  { name: 'Facebook', url: site.social.facebook },
  { name: 'Telegram', url: site.social.telegram },
  { name: 'Google Карти', url: site.googleMaps },
].filter((s) => s.url);
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <div class="brand__text">
        <strong><span class="brand__lux">Lux</span> Dzerkalo</strong>
        <small>{t('site.tagline')}</small>
      </div>
      <p class="footer-about">{t('footer.about')}</p>
      {socials.length > 0 && (
        <div class="footer-social">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.name}>{s.name}</a>
          ))}
        </div>
      )}
    </div>

    <div>
      <h4>{t('footer.catalog')}</h4>
      <ul>
        {categories.slice(0, 6).map((c) => (
          <li><a href={localizePath(`/katalog/${c.slug}/`, lang)}>{catTitle(c, lang)}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4>{t('footer.menu')}</h4>
      <ul>
        {navItems.map((item) => (
          <li><a href={localizePath(item.path, lang)}>{t(item.key)}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4>{svcHeading}</h4>
      <ul>
        {svcLinks.map((s) => (
          <li><a href={s.href}>{s.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4>{t('footer.contacts')}</h4>
      <ul class="footer-contacts">
        {site.phones.map((p) => (
          <li><a href={`tel:${p.tel}`}>{p.display}</a></li>
        ))}
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{st.addressFull}</li>
        <li>{st.workingHours}</li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <span>© {year} {site.name}. {t('footer.rights')}</span>
    <div class="footer-lang" aria-label="Language">
      <a href={altUk} class:list={['footer-lang__opt', { active: lang === 'uk' }]} hreflang="uk-UA">UA</a>
      <span class="footer-lang__sep">/</span>
      <a href={altRu} class:list={['footer-lang__opt', { active: lang === 'ru' }]} hreflang="ru-RU">RU</a>
    </div>
    <span>{st.addressFull}</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--bg-dark); color: #aeb6c0; padding-top: 64px; }
  .site-footer__grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1.2fr; gap: 40px; padding-bottom: 48px; }
  .site-footer h4 { color: #fff; font-family: var(--font); font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem; }
  .site-footer ul { list-style: none; padding: 0; margin: 0; }
  .site-footer li { margin-bottom: 0.6rem; font-size: 0.95rem; }
  .site-footer a { color: #aeb6c0; }
  .site-footer a:hover { color: var(--accent); }
  .brand__text strong { color: #fff; font-family: var(--serif); font-size: 1.4rem; display: block; }
  .brand__text strong .brand__lux { color: var(--accent); }
  .brand__text small { color: var(--accent); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; }
  .footer-about { margin-top: 1rem; font-size: 0.95rem; max-width: 32ch; }
  .footer-social { display: flex; gap: 16px; margin-top: 1rem; }
  .footer-social a { font-weight: 600; color: #fff; }
  .footer-contacts a { font-weight: 600; color: #fff; }
  .site-footer__bottom {
    display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;
    padding: 22px 20px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 0.85rem; color: #79828d;
  }
  .footer-lang { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 0.95rem; }
  .footer-lang__opt { color: #aeb6c0; padding: 2px 4px; }
  .footer-lang__opt:hover { color: var(--accent); }
  .footer-lang__opt.active { color: var(--accent); }
  .footer-lang__sep { color: #4a525c; }
  @media (max-width: 1050px) { .site-footer__grid { grid-template-columns: 1fr 1fr 1fr; } }
  @media (max-width: 800px) { .site-footer__grid { grid-template-columns: 1fr 1fr; gap: 30px; } }
  @media (max-width: 480px) { .site-footer__grid { grid-template-columns: 1fr; } }
</style>

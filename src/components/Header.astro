---
import { site, navItems } from '../data/site';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === localizePath('/', lang) ? current === href || current === href.replace(/\/$/, '')
    : current.startsWith(href);
const primaryPhone = site.phones[0];

// Перемикач мови: той самий шлях у протилежній мові
const stripped = current.replace(/^\/ru(\/|$)/, '/');
const altUk = stripped === '' ? '/' : stripped;
const altRu = altUk === '/' ? '/ru/' : `/ru${altUk}`;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={localizePath('/', lang)} class="brand" aria-label={site.name}>
      <span class="brand__mark">L<span>Z</span></span>
      <span class="brand__text">
        <strong>Lux Zerkalo</strong>
        <small>{t('header.brandSub')}</small>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="nav">
      {navItems.map((item) => {
        const href = localizePath(item.path, lang);
        return (
          <a href={href} class:list={['site-nav__link', { active: isActive(href) }]}>
            {t(item.key)}
          </a>
        );
      })}
    </nav>

    <div class="header-right">
      {site.social.facebook && (
        <a href={site.social.facebook} class="header-ig" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.9 3.78-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.9h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z"></path>
          </svg>
        </a>
      )}
      {site.social.instagram && (
        <a href={site.social.instagram} class="header-ig" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      )}
      <div class="lang-switch" aria-label="Language">
        <a href={altUk} class:list={['lang-switch__opt', { active: lang === 'uk' }]} hreflang="uk-UA">UA</a>
        <span>/</span>
        <a href={altRu} class:list={['lang-switch__opt', { active: lang === 'ru' }]} hreflang="ru-RU">RU</a>
      </div>
      <a href={`tel:${primaryPhone.tel}`} class="header-phone">
        <span class="header-phone__icon" aria-hidden="true">☎</span>
        {primaryPhone.display}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner { display: flex; align-items: center; gap: 24px; min-height: 74px; }
  .brand { display: flex; align-items: center; gap: 12px; margin-right: auto; }
  .brand__mark {
    width: 46px; height: 46px; border-radius: 12px;
    display: inline-flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #1a1f26, #2c333d);
    color: #fff; font-family: var(--serif); font-weight: 700; font-size: 1.3rem;
    line-height: 1; letter-spacing: 0.5px;
  }
  .brand__mark span { color: var(--accent); }
  .brand__text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand__text strong { font-family: var(--serif); font-size: 1.2rem; color: var(--ink); }
  .brand__text small { color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; }

  .site-nav { display: flex; align-items: center; gap: 28px; }
  .site-nav__link { color: var(--ink); font-weight: 500; font-size: 0.98rem; position: relative; }
  .site-nav__link::after {
    content: ''; position: absolute; left: 0; bottom: -6px; height: 2px; width: 0;
    background: var(--accent); transition: width 0.2s;
  }
  .site-nav__link:hover { color: var(--accent-dark); }
  .site-nav__link.active { color: var(--accent-dark); }
  .site-nav__link.active::after { width: 100%; }

  .header-right { display: flex; align-items: center; gap: 16px; }
  .header-ig { color: var(--ink-soft); display: inline-flex; }
  .header-ig:hover { color: var(--accent-dark); }
  .lang-switch { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 0.92rem; font-weight: 600; }
  .lang-switch__opt { color: var(--muted); }
  .lang-switch__opt:hover { color: var(--accent-dark); }
  .lang-switch__opt.active { color: var(--ink); }

  .header-phone {
    display: inline-flex; align-items: center; gap: 8px;
    font-weight: 700; color: var(--ink); white-space: nowrap;
    padding: 0.5em 1em; border-radius: 999px; border: 1.5px solid var(--line);
  }
  .header-phone:hover { border-color: var(--accent); color: var(--accent-dark); }
  .header-phone__icon { color: var(--accent); }

  .burger { display: none; cursor: pointer; flex-direction: column; gap: 5px; padding: 8px; }
  .burger span { width: 24px; height: 2px; background: var(--ink); border-radius: 2px; transition: 0.25s; }

  @media (max-width: 900px) {
    .burger { display: flex; order: 3; }
    .header-phone { display: none; }
    .site-nav {
      position: absolute; top: 74px; left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: #fff; border-bottom: 1px solid var(--line);
      max-height: 0; overflow: hidden; transition: max-height 0.3s ease;
    }
    .site-nav__link { padding: 16px 20px; border-top: 1px solid var(--line); }
    .site-nav__link::after { display: none; }
    .nav-toggle:checked ~ .site-nav { max-height: 60vh; }
    .nav-toggle:checked ~ .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>

---
import { site, navItems } from '../data/site';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === localizePath('/', lang) ? current === href || current === href.replace(/\/$/, '')
    : current.startsWith(href);
const primaryPhone = site.phones[0];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={localizePath('/', lang)} class="brand" aria-label={site.name}>
      <span class="brand__mark"><span class="brand__mono">L<span>D</span></span></span>
      <span class="brand__text">
        <strong><span class="brand__lux">Lux</span> Dzerkalo</strong>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />

    <nav class="site-nav" aria-label="nav">
      {navItems.map((item) => {
        const href = localizePath(item.path, lang);
        return (
          <a href={href} class:list={['site-nav__link', { active: isActive(href) }]}>
            {t(item.key)}
          </a>
        );
      })}
    </nav>

    <div class="header-right">
      {site.social.facebook && (
        <a href={site.social.facebook} class="header-ig" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
            <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.9 3.78-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.9h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z"></path>
          </svg>
        </a>
      )}
      {site.social.instagram && (
        <a href={site.social.instagram} class="header-ig" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      )}
      <a href={`tel:${primaryPhone.tel}`} class="header-phone">
        <span class="header-phone__icon" aria-hidden="true">☎</span>
        {primaryPhone.display}
      </a>
      <label for="nav-toggle" class="burger" aria-label="Menu">
        <span></span><span></span><span></span>
      </label>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  /* Шапка ширша за контент — просторіше меню */
  .site-header__inner { max-width: 1280px; display: flex; align-items: center; gap: 24px; min-height: 74px; }
  .brand { display: flex; align-items: center; gap: 14px; margin-right: auto; }
  .brand__mark {
    position: relative;
    width: 50px; height: 50px; border-radius: 13px;
    display: inline-flex; align-items: center; justify-content: center;
    background: linear-gradient(150deg, #222a34 0%, #11161c 100%);
    box-shadow: 0 4px 14px rgba(17, 22, 28, 0.28);
    overflow: hidden;
    flex-shrink: 0;
  }
  /* тонка золота рамка — як у дзеркала */
  .brand__mark::before {
    content: ''; position: absolute; inset: 4px;
    border: 1px solid rgba(184, 146, 63, 0.55);
    border-radius: 8px; pointer-events: none;
  }
  /* делікатний полиск зверху */
  .brand__mark::after {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 50%;
    background: linear-gradient(180deg, rgba(255,255,255,0.14), rgba(255,255,255,0));
    pointer-events: none;
  }
  .brand__mono {
    position: relative; z-index: 1;
    font-family: var(--serif); font-weight: 700; font-size: 1.32rem;
    line-height: 1; letter-spacing: 1px; color: #f3ede0;
  }
  .brand__mono span { color: var(--accent); }
  .brand__text { display: flex; flex-direction: column; line-height: 1.05; }
  .brand__text strong { font-family: var(--serif); font-size: 1.32rem; font-weight: 600; color: var(--ink); letter-spacing: 0.3px; white-space: nowrap; }
  .brand__lux { color: var(--accent-dark); }
  .brand__text small { color: var(--muted); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.22em; margin-top: 3px; }

  .site-nav { display: flex; align-items: center; gap: 28px; }
  .site-nav__link { color: var(--ink); font-weight: 500; font-size: 0.98rem; position: relative; }
  .site-nav__link::after {
    content: ''; position: absolute; left: 0; bottom: -6px; height: 2px; width: 0;
    background: var(--accent); transition: width 0.2s;
  }
  .site-nav__link:hover { color: var(--accent-dark); }
  .site-nav__link.active { color: var(--accent-dark); }
  .site-nav__link.active::after { width: 100%; }

  .header-right { display: flex; align-items: center; gap: 16px; }
  .header-ig { color: var(--ink-soft); display: inline-flex; }
  .header-ig:hover { color: var(--accent-dark); }

  .header-phone {
    display: inline-flex; align-items: center; gap: 8px;
    font-weight: 700; color: var(--ink); white-space: nowrap;
    padding: 0.5em 1em; border-radius: 999px; border: 1.5px solid var(--line);
  }
  .header-phone:hover { border-color: var(--accent); color: var(--accent-dark); }
  .header-phone__icon { color: var(--accent); }

  /* Бургер живе в групі з іконками соцмереж */
  .burger { display: none; cursor: pointer; flex-direction: column; gap: 5px; padding: 4px; }
  .burger span { width: 24px; height: 2px; background: var(--ink); border-radius: 2px; transition: 0.25s; }

  @media (max-width: 900px) {
    .burger { display: flex; }
    .header-phone { display: none; }
    .site-nav {
      position: absolute; top: 74px; left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: #fff; border-bottom: 1px solid var(--line);
      max-height: 0; overflow: hidden; transition: max-height 0.3s ease;
    }
    .site-nav__link { padding: 16px 20px; border-top: 1px solid var(--line); }
    .site-nav__link::after { display: none; }
    .nav-toggle:checked ~ .site-nav { max-height: 70vh; }
    .nav-toggle:checked ~ .header-right .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .header-right .burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .header-right .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>

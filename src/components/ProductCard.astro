---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/ui';
import { productSlug } from '../lib/products';

interface Props {
  product: CollectionEntry<'products'>;
}
const { product } = Astro.props;
const { data } = product;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = localizePath(`/tovar/${productSlug(product)}/`, lang);
---

<article class="card">
  <a class="card__media" href={href} aria-label={data.title}>
    <Image src={data.image} alt={data.title} width={520} height={390} />
  </a>
  <div class="card__body">
    <h3><a href={href}>{data.title}</a></h3>
    <p>{data.summary}</p>
    <div class="card__foot">
      {data.priceFrom ? (
        <span class="price">{t('common.priceFrom')} {data.priceFrom.toLocaleString('uk-UA')} <span>{data.priceUnit}</span></span>
      ) : (
        <span class="price"><span>{t('common.priceRequest')}</span></span>
      )}
      <a class="link-arrow" href={href}>{t('common.more')}</a>
    </div>
  </div>
</article>

<style>
  .card__body h3 a { color: var(--ink); }
  .card__body h3 a:hover { color: var(--accent-dark); }
</style>

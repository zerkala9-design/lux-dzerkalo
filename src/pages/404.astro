---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Сторінку не знайдено" noindex={true}>
  <section class="section" style="text-align:center; min-height: 48vh; display:grid; place-content:center;">
    <div class="container">
      <p class="eyebrow">Помилка 404</p>
      <h1>Такої сторінки не існує</h1>
      <p style="color: var(--ink-soft); max-width: 46ch; margin-inline:auto;">
        Можливо, сторінку переміщено або видалено. Поверніться на головну або перегляньте каталог.
      </p>
      <div style="display:flex; gap:12px; justify-content:center; margin-top:1.6rem; flex-wrap:wrap;">
        <a href="/" class="btn btn--primary">На головну</a>
        <a href="/katalog/" class="btn btn--ghost">До каталогу</a>
      </div>
    </div>
  </section>
</BaseLayout>

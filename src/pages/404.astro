---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizePath } from '../i18n/ui';
const t = useTranslations('uk');
---

<BaseLayout title={t('404.title')} noindex={true}>
  <section class="section" style="text-align:center; min-height: 48vh; display:grid; place-content:center;">
    <div class="container">
      <p class="eyebrow">{t('404.eyebrow')}</p>
      <h1>{t('404.title')}</h1>
      <p style="color: var(--ink-soft); max-width: 46ch; margin-inline:auto;">{t('404.text')}</p>
      <div style="display:flex; gap:12px; justify-content:center; margin-top:1.6rem; flex-wrap:wrap;">
        <a href={localizePath('/', 'uk')} class="btn btn--primary">{t('404.home')}</a>
        <a href={localizePath('/katalog/', 'uk')} class="btn btn--ghost">{t('404.catalog')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

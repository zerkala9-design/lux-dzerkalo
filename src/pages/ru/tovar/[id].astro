---
import type { GetStaticPaths } from 'astro';
import ProductPage from '../../../components/pages/ProductPage.astro';
import { getProductsByLang, productSlug } from '../../../lib/products';

export const getStaticPaths = (async () => {
  const products = await getProductsByLang('ru');
  return products.map((product) => ({ params: { id: productSlug(product) }, props: { product } }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
---
<ProductPage product={product} />

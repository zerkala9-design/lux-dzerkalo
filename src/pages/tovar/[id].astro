---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import CallbackForm from '../../components/CallbackForm.astro';
import { site } from '../../data/site';
import { getCategory } from '../../data/categories';

export const getStaticPaths = (async () => {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const { data } = product;
const { Content } = await render(product);
const category = getCategory(data.category);

// Схожі товари тієї ж категорії
const related = (await getCollection('products'))
  .filter((p) => p.data.category === data.category && p.id !== product.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const gallery = [data.image, ...(data.gallery ?? [])];

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.title,
  description: data.summary,
  image: new URL(data.image.src, site.url).href,
  category: category?.title,
  brand: { '@type': 'Brand', name: site.name },
  ...(data.priceFrom
    ? {
        offers: {
          '@type': 'Offer',
          price: data.priceFrom,
          priceCurrency: 'UAH',
          availability: 'https://schema.org/InStock',
          url: new URL(`/tovar/${product.id}/`, site.url).href,
        },
      }
    : {}),
};
---

<BaseLayout title={data.title} description={data.summary} jsonLd={productLd}>
  <section class="page-head page-head--slim">
    <div class="container">
      <nav class="crumbs">
        <a href="/">Головна</a> / <a href="/katalog/">Каталог</a>
        {category && <> / <a href={`/katalog/${category.slug}/`}>{category.title}</a></>}
        / <span>{data.title}</span>
      </nav>
    </div>
  </section>

  <section class="section product">
    <div class="container product__grid">
      <div class="product__gallery">
        <div class="product__main">
          <Image src={data.image} alt={data.title} width={760} height={570} id="main-image" />
        </div>
        {gallery.length > 1 && (
          <div class="product__thumbs">
            {gallery.map((img, i) => (
              <button class:list={['thumb', { active: i === 0 }]} data-src={img.src} aria-label={`Фото ${i + 1}`}>
                <Image src={img} alt={`${data.title} — фото ${i + 1}`} width={160} height={120} />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="product__info">
        {category && <a href={`/katalog/${category.slug}/`} class="eyebrow">{category.title}</a>}
        <h1>{data.title}</h1>
        <p class="product__summary">{data.summary}</p>

        <div class="product__price">
          {data.priceFrom ? (
            <><strong>від {data.priceFrom.toLocaleString('uk-UA')} {data.priceUnit}</strong>
            <span>остаточна ціна — після замірів</span></>
          ) : (
            <strong>Ціна за запитом</strong>
          )}
        </div>

        {data.features.length > 0 && (
          <ul class="product__features">
            {data.features.map((f) => <li>{f}</li>)}
          </ul>
        )}

        <div class="product__actions">
          <a href="#zayavka" class="btn btn--primary">Замовити прорахунок</a>
          <a href={`tel:${site.phones[0].tel}`} class="btn btn--ghost">☎ {site.phones[0].display}</a>
        </div>

        <div class="product__desc">
          <Content />
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <div class="section-head"><span class="eyebrow">Схожі товари</span><h2>Також з цієї категорії</h2></div>
        <div class="grid grid--3">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}

  <CallbackForm />
</BaseLayout>

<style>
  .page-head--slim { padding: clamp(24px, 4vw, 36px) 0; background: var(--bg-soft); }
  .crumbs { font-size: 0.88rem; color: var(--muted); }
  .crumbs a { color: var(--ink-soft); }

  .product__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: start; }
  .product__main { border-radius: var(--radius); overflow: hidden; background: var(--bg-soft); border: 1px solid var(--line); }
  .product__main img { width: 100%; height: auto; object-fit: cover; }
  .product__thumbs { display: flex; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .thumb {
    width: 90px; height: 70px; border-radius: var(--radius-sm); overflow: hidden;
    border: 2px solid var(--line); padding: 0; cursor: pointer; background: none;
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb.active { border-color: var(--accent); }

  .product__summary { font-size: 1.1rem; color: var(--ink-soft); }
  .product__price {
    display: flex; flex-direction: column; gap: 2px; margin: 1.2rem 0;
    padding: 1rem 1.2rem; background: var(--accent-soft); border-radius: var(--radius-sm);
  }
  .product__price strong { font-family: var(--serif); font-size: 1.5rem; color: var(--ink); }
  .product__price span { font-size: 0.85rem; color: var(--ink-soft); }
  .product__features { list-style: none; padding: 0; margin: 0 0 1.6rem; display: grid; gap: 0.55rem; }
  .product__features li { padding-left: 28px; position: relative; }
  .product__features li::before { content: '✓'; position: absolute; left: 0; color: var(--accent-dark); font-weight: 700; }
  .product__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 2rem; }
  .product__desc { border-top: 1px solid var(--line); padding-top: 1.6rem; color: var(--ink-soft); }
  .product__desc :global(strong) { color: var(--ink); }

  @media (max-width: 860px) { .product__grid { grid-template-columns: 1fr; gap: 28px; } }
</style>

<script>
  const main = document.getElementById('main-image') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.thumb');
  thumbs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const img = btn.querySelector('img');
      if (main && img) {
        main.src = img.currentSrc || img.src;
        main.removeAttribute('srcset');
      }
      thumbs.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });
</script>

---
import type { GetStaticPaths } from 'astro';
import ArticlePage from '../../components/pages/ArticlePage.astro';
import { getArticlesByLang, articleSlug } from '../../lib/articles';

export const getStaticPaths = (async () => {
  const articles = await getArticlesByLang('uk');
  return articles.map((article) => ({ params: { slug: articleSlug(article) }, props: { article } }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
---
<ArticlePage article={article} />

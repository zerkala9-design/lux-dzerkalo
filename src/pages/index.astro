---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import CallbackForm from '../components/CallbackForm.astro';
import { site } from '../data/site';
import { categories } from '../data/categories';
import heroImg from '../assets/gallery/interior-1.jpg';

const products = await getCollection('products');
const featured = products
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const advantages = [
  { icon: '📐', title: 'Будь-які розміри', text: 'Виготовляємо за індивідуальними розмірами під ваш інтер’єр.' },
  { icon: '🛠️', title: 'Монтаж «під ключ»', text: 'Заміри, доставка та професійна установка нашою бригадою.' },
  { icon: '⏱️', title: 'Швидкі терміни', text: 'Стандартні замовлення — від 2–3 робочих днів.' },
  { icon: '🛡️', title: 'Гарантія якості', text: 'Якісне дзеркало й фурнітура, акуратне кріплення, гарантія на роботи.' },
];

const steps = [
  { n: '01', title: 'Заявка', text: 'Залишаєте заявку або телефонуєте — обговорюємо ваше завдання.' },
  { n: '02', title: 'Заміри', text: 'Майстер виїжджає на заміри та консультує щодо рішень.' },
  { n: '03', title: 'Виготовлення', text: 'Виготовляємо дзеркало за вашими розмірами на виробництві.' },
  { n: '04', title: 'Монтаж', text: 'Доставляємо й встановлюємо — чисто та надійно.' },
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__bg">
      <Image src={heroImg} alt="Дзеркала на замовлення у Києві" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="hero__overlay"></div>
    </div>
    <div class="container hero__inner">
      <span class="eyebrow hero__eyebrow">Виробництво у Києві з 2011 року</span>
      <h1>Дзеркала на замовлення,<br />виготовлені під ваш простір</h1>
      <p>
        Дзеркала для ванної, з фацетом і LED-підсвіткою, дзеркальна плитка, панно,
        дзеркала для спортзалів та вироби зі скла. Заміри, виготовлення й монтаж «під ключ».
      </p>
      <div class="hero__actions">
        <a href="#zayavka" class="btn btn--primary">Замовити прорахунок</a>
        <a href="/katalog/" class="btn btn--light">Переглянути каталог</a>
      </div>
      <div class="hero__contacts">
        {site.phones.map((p) => (
          <a href={`tel:${p.tel}`}>{p.display}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ADVANTAGES -->
  <section class="section">
    <div class="container">
      <div class="grid grid--4">
        {advantages.map((a) => (
          <div class="adv">
            <span class="adv__icon" aria-hidden="true">{a.icon}</span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Каталог</span>
        <h2>Що ми виготовляємо</h2>
        <p>Оберіть категорію — або замовте індивідуальне рішення за вашим ескізом.</p>
      </div>
      <div class="grid grid--4 cat-grid">
        {categories.map((c) => (
          <a href={`/katalog/${c.slug}/`} class="cat-tile">
            <h3>{c.title}</h3>
            <p>{c.short}</p>
            <span class="link-arrow">Детальніше</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED PRODUCTS -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Популярне</span>
        <h2>Популярні рішення</h2>
        <p>Найчастіше замовляють ці дзеркала. Усі — за індивідуальними розмірами.</p>
      </div>
      <div class="grid grid--4">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
      <div style="text-align:center; margin-top: 2.5rem;">
        <a href="/katalog/" class="btn btn--ghost">Увесь каталог</a>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Як ми працюємо</span>
        <h2>4 кроки до вашого дзеркала</h2>
      </div>
      <div class="grid grid--4">
        {steps.map((s) => (
          <div class="step">
            <span class="step__n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CallbackForm />
</BaseLayout>

<style>
  /* HERO */
  .hero { position: relative; color: #fff; isolation: isolate; }
  .hero__bg { position: absolute; inset: 0; z-index: -1; }
  .hero__bg img { width: 100%; height: 100%; object-fit: cover; }
  .hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(105deg, rgba(15,20,26,0.92) 0%, rgba(15,20,26,0.72) 45%, rgba(15,20,26,0.45) 100%);
  }
  .hero__inner { padding: clamp(70px, 12vw, 150px) 20px; max-width: 760px; }
  .hero__eyebrow { color: var(--accent); }
  .hero h1 { color: #fff; }
  .hero p { color: #d7dde4; font-size: 1.15rem; max-width: 56ch; }
  .hero__actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 1.8rem; }
  .hero__contacts { display: flex; gap: 24px; margin-top: 1.8rem; flex-wrap: wrap; }
  .hero__contacts a { color: #fff; font-weight: 700; font-size: 1.15rem; font-family: var(--serif); }
  .hero__contacts a:hover { color: var(--accent); }

  /* Advantages */
  .adv { text-align: left; }
  .adv__icon { font-size: 2rem; display: block; margin-bottom: 0.6rem; }
  .adv h3 { font-size: 1.15rem; }
  .adv p { color: var(--ink-soft); font-size: 0.96rem; }

  /* Category tiles */
  .cat-tile {
    display: flex; flex-direction: column; gap: 0.3rem;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    padding: 24px 22px; color: var(--ink); transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .cat-tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: transparent; }
  .cat-tile h3 { font-size: 1.18rem; margin-bottom: 0.2rem; }
  .cat-tile p { color: var(--ink-soft); font-size: 0.93rem; flex: 1; margin-bottom: 0.8rem; }

  /* Steps */
  .step { position: relative; padding-top: 8px; }
  .step__n {
    font-family: var(--serif); font-size: 2.6rem; font-weight: 700;
    color: var(--accent); opacity: 0.5; display: block; line-height: 1;
  }
  .step h3 { margin-top: 0.6rem; font-size: 1.2rem; }
  .step p { color: var(--ink-soft); font-size: 0.96rem; }
</style>

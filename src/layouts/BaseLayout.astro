---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, siteText } from '../data/site';
import { getLangFromUrl } from '../i18n/ui';
import { reviews, reviewStats } from '../data/reviews';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  alternates?: boolean;
  hreflang?: { uk: string; ru: string };
  withReviews?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const st = siteText(lang);
const { title, description = st.description, image, jsonLd, noindex, alternates = true, hreflang, withReviews = false } = Astro.props;
const htmlLang = lang === 'ru' ? 'ru' : 'uk';

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  description: st.description,
  url: site.url,
  foundingDate: '2011',
  email: site.email,
  telephone: site.phones.map((p) => p.tel),
  image: new URL('/og-default.jpg', site.url).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address,
    addressLocality: lang === 'ru' ? 'Киев' : 'Київ',
    addressCountry: 'UA',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  areaServed: lang === 'ru' ? 'Киев и область' : 'Київ та область',
  sameAs: [
    site.googleMaps,
    site.social.instagram,
    site.social.facebook,
    site.social.telegram,
  ].filter(Boolean),
  // Рейтинг і відгуки вливаємо в ЄДИНИЙ вузол LocalBusiness (лише там, де є блок відгуків),
  // щоб не плодити другий LocalBusiness-вузол у structured data.
  ...(withReviews
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: reviewStats.ratingValue,
          reviewCount: reviewStats.reviewCount,
          bestRating: 5,
        },
        review: reviews.map((r) => ({
          '@type': 'Review',
          author: { '@type': 'Person', name: r.author },
          reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 },
          reviewBody: r.text,
          ...(r.date ? { datePublished: r.date } : {}),
        })),
      }
    : {}),
};

const allLd = jsonLd ? [orgLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : orgLd;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <Seo title={title} description={description} image={image} jsonLd={allLd} noindex={noindex} alternates={alternates} hreflang={hreflang} />
    {site.analytics.googleSiteVerification && (
      <meta name="google-site-verification" content={site.analytics.googleSiteVerification} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Шрифти вантажимо неблокуюче (media=print→all): не тримають рендер, текст показується одразу (display=swap). -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <Analytics />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <a class="float-call" href={`tel:${site.phones[0].tel}`} aria-label="Call">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
        <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"></path>
      </svg>
    </a>

    <style>
      .float-call {
        position: fixed; right: 18px; bottom: 18px; z-index: 60;
        width: 56px; height: 56px; border-radius: 50%;
        display: none; place-items: center;
        background: var(--accent); color: #fff; font-size: 1.4rem;
        box-shadow: var(--shadow-lg); animation: pulse 2.4s infinite;
      }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(184, 146, 63, 0.5); }
        70% { box-shadow: 0 0 0 14px rgba(184, 146, 63, 0); }
        100% { box-shadow: 0 0 0 0 rgba(184, 146, 63, 0); }
      }
      @media (max-width: 900px) { .float-call { display: grid; } }
    </style>
  </body>
</html>

# Приватний кабінет /kabinet — вхід через index.php (серверний пароль).
# Захист не залежить від цього файлу: index.php ставить сесію, а app.php
# сам перевіряє її на початку, тож прямий доступ без входу неможливий у будь-якому разі.

DirectoryIndex index.php

# Не індексувати кабінет пошуковими системами.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

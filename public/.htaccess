# ===== Lux Zerkalo — Apache (.htaccess) =====
# Згенеровано автоматично. Кладеться в корінь сайту (public_html).

Options -Indexes
DirectoryIndex index.html

# --- Примусовий HTTPS ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # виняток для перевірки Let's Encrypt (ACME) — не редиректити на https
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # без www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Заголовки безпеки ---
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; frame-src https://maps.google.com https://www.google.com https://maps.googleapis.com; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; form-action 'self' mailto:; base-uri 'self'; object-src 'none'"
</IfModule>

# --- Кешування статики ---
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|gif|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Стиснення ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# ===== 301-редиректи зі старого сайту =====
<IfModule mod_alias.c>
  RedirectMatch 301 "^/ru/glavnaja\.html$" "/ru/"

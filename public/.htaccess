# ===== Lux Dzerkalo — Apache (.htaccess) =====
# Кладеться в корінь сайту (www).

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Канонічний хост: без www одразу на https (ОДИН редірект) ---
  # Правило www стоїть ПЕРШИМ і вже пише https://, тож http://www/ → https://non-www/ за 1 стрибок.
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # --- Примусовий HTTPS для non-www (за проксі adm.tools через X-Forwarded-Proto) ---
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- Канонікалізація (чистка канібалізації): видалені дублі → головні сторінки.
  #     Ставимо ВИЩЕ за "віддати реальний файл", щоб 301 спрацював навіть якщо
  #     старий файл ще лишився на хостингу. ---
  RewriteRule "^statti/zamoviti-dzerkalo-_kiyiv_/?$" "https://%{HTTP_HOST}/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^statti/stilni-ta-praktichni-dzerkala-dlya-tantsyuvalnogo-zalu/?$" "https://%{HTTP_HOST}/statti/dzerkala-dlya-tantsyuvalnoyi-studiyi/" [R=301,L]
  # --- Прибирання 404-«привидів» від старого перемикача мов (UK-шляхи RU-only статей) ---
  RewriteRule "^statti/zerkala-dlya-sportzala-kupit/?$" "https://%{HTTP_HOST}/statti/dzerkala-dlya-sportzalu-rozmiry-montazh/" [R=301,L]
  RewriteRule "^statti/zerkala-dlya-sportzala/?$" "https://%{HTTP_HOST}/statti/dzerkala-dlya-sportzalu-rozmiry-montazh/" [R=301,L]
  RewriteRule "^statti/2017_09_zerkalo-v-vannuyu-komnatu-kiev/?$" "https://%{HTTP_HOST}/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^statti/zerkalnaja_plitka/?$" "https://%{HTTP_HOST}/katalog/dzerkalna-plitka/" [R=301,L]
  RewriteRule "^statti/zerkalnaya-potolochnaya-plitka/?$" "https://%{HTTP_HOST}/katalog/dzerkalna-plitka/" [R=301,L]
  RewriteRule "^statti/proizvodstvo-zerkalnoy-plitki/?$" "https://%{HTTP_HOST}/katalog/dzerkalna-plitka/" [R=301,L]
  RewriteRule "^statti/izgotovlenie-zerkalnoy-plitki/?$" "https://%{HTTP_HOST}/katalog/dzerkalna-plitka/" [R=301,L]
  RewriteRule "^statti/steklo-4-mm/?$" "https://%{HTTP_HOST}/katalog/" [R=301,L]
  RewriteRule "^statti/porezka-stekla/?$" "https://%{HTTP_HOST}/katalog/" [R=301,L]
  RewriteRule "^statti/obychnye-zerkala/?$" "https://%{HTTP_HOST}/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^ru/statti/2017_09_zakazat-zerkalo-_kiev_/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^ru/statti/2017_izgotovit-zerkalo-pod-zakaz/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^ru/statti/2017_izgotovlenie-zerkal-na-zakaz/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^ru/statti/2023_zerkala-pod-zakaz-v-kieve/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^ru/statti/izgotovlenie_zerkal/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^ru/statti/zerkala_na_zakaz/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^ru/statti/zerkala_pod_zakaz/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^ru/statti/zerkalo_na_zakaz_kiev/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^ru/statti/zerkala-dlya-sportzala/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-dlya-sportzalu-rozmiry-montazh/" [R=301,L]
  RewriteRule "^ru/statti/zerkala-dlya-sportzalov/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-dlya-sportzalu-rozmiry-montazh/" [R=301,L]
  RewriteRule "^ru/statti/zerkala-dlya-sportzala-kupit/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-dlya-sportzalu-rozmiry-montazh/" [R=301,L]
  RewriteRule "^ru/statti/zerkala-dlya-sportzala-v-kieve/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-dlya-sportzalu-rozmiry-montazh/" [R=301,L]
  RewriteRule "^ru/statti/zerkala-dlya-tantsev-i-dlya-sporta/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-dlya-tantsyuvalnoyi-studiyi/" [R=301,L]
  RewriteRule "^ru/statti/kupit_zerkala_dlja_tancevalnogo_zala/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-dlya-tantsyuvalnoyi-studiyi/" [R=301,L]
  RewriteRule "^ru/statti/2023_stilnye-i-praktichnye-zerkala-dlya-tantsevalnogo-zala/?$" "https://%{HTTP_HOST}/ru/statti/dzerkala-dlya-tantsyuvalnoyi-studiyi/" [R=301,L]
  RewriteRule "^ru/statti/zerkala-v-fitnes-zal_-tsena/?$" "https://%{HTTP_HOST}/ru/statti/dzerkalna-stina-u-fitnes-klub/" [R=301,L]
  RewriteRule "^ru/statti/zerkalo-v-fitnes-zal/?$" "https://%{HTTP_HOST}/ru/statti/dzerkalna-stina-u-fitnes-klub/" [R=301,L]
  RewriteRule "^statti/dzerkalo-u-vannu-kimnatu-kupiti-v-kievi/?$" "https://%{HTTP_HOST}/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^statti/dzerkala-dlya-vann-kiyiv/?$" "https://%{HTTP_HOST}/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^statti/vanne-dzerkalo-kupiti-_kiyiv_/?$" "https://%{HTTP_HOST}/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^ru/statti/2017_09_vannoe-zerkalo-kupit-_kiev_/?$" "https://%{HTTP_HOST}/ru/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^ru/statti/2017_09_zerkala-dlya-vann-kiev/?$" "https://%{HTTP_HOST}/ru/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^ru/statti/2017_09_zerkalo-v-vannuyu-komnatu-kiev/?$" "https://%{HTTP_HOST}/ru/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^ru/statti/2017_09_zerkalo-v-vannuyu-komnatu-kupit-v-kieve/?$" "https://%{HTTP_HOST}/ru/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^ru/statti/2017_zerkalo-dlya-vanny-pod-zakaz/?$" "https://%{HTTP_HOST}/ru/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^ru/statti/zerkalo-v-vannuyu/?$" "https://%{HTTP_HOST}/ru/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^ru/statti/2023_zerkalnoe-panno-v-ukraine---stilniy-i-funktsionalniy-element/?$" "https://%{HTTP_HOST}/ru/statti/dzerkalne-panno-v-ukrayini---stilniy-ta-funktsionalniy-element/" [R=301,L]

  # --- ВАЖЛИВО: якщо реальний файл або тека існують — віддати їх, не редиректити ---
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # --- 301-редиректи зі старого сайту (лише для неіснуючих шляхів) ---
  RewriteRule "^ru/glavnaja\.html$" "https://%{HTTP_HOST}/ru/" [R=301,L]
  RewriteRule "^ua/golovna\.html$" "https://%{HTTP_HOST}/" [R=301,L]
  RewriteRule "^index\.html$" "https://%{HTTP_HOST}/" [R=301,L]
  RewriteRule "^ua/poslugi\.html$" "https://%{HTTP_HOST}/poslugy/" [R=301,L]
  RewriteRule "^ua/kontakti_ua\.html$" "https://%{HTTP_HOST}/kontakty/" [R=301,L]
  RewriteRule "^ua/zamoviti-zvorotniy-dzvinok\.html$" "https://%{HTTP_HOST}/kontakty/" [R=301,L]
  RewriteRule "^ua/zamoviti-rozrahunok-vartosti\.html$" "https://%{HTTP_HOST}/kontakty/" [R=301,L]
  RewriteRule "^ua/prays-list_ua\.html$" "https://%{HTTP_HOST}/katalog/" [R=301,L]
  RewriteRule "^ua/gotovi-dzerkala\.html$" "https://%{HTTP_HOST}/katalog/" [R=301,L]
  RewriteRule "^ua/dzerkala-dlya-vannoyi-kimnati\.html$" "https://%{HTTP_HOST}/katalog/dzerkala-dlya-vannoyi/" [R=301,L]
  RewriteRule "^ua/dzerkala-dlya-sportzaliv\.html$" "https://%{HTTP_HOST}/katalog/dzerkala-dlya-sportzaliv/" [R=301,L]
  RewriteRule "^ua/horeografichni-stanki\.html$" "https://%{HTTP_HOST}/katalog/dzerkala-dlya-sportzaliv/" [R=301,L]
  RewriteRule "^ua/dzerkalna-plitka\.html$" "https://%{HTTP_HOST}/katalog/dzerkalna-plitka/" [R=301,L]
  RewriteRule "^ua/dzerkalna-plitka_main\.html$" "https://%{HTTP_HOST}/katalog/dzerkalna-plitka/" [R=301,L]
  RewriteRule "^ua/dzerkalni-panno\.html$" "https://%{HTTP_HOST}/katalog/dzerkalni-panno/" [R=301,L]
  RewriteRule "^ua/dzerkalne-panno-_montaj_\.html$" "https://%{HTTP_HOST}/katalog/dzerkalni-panno/" [R=301,L]
  RewriteRule "^ua/dzerkalo-z-fatsetom\.html$" "https://%{HTTP_HOST}/katalog/dzerkala-z-fatsetom/" [R=301,L]
  RewriteRule "^ua/dzerkala-v-inter_eri\.html$" "https://%{HTTP_HOST}/katalog/dzerkala-v-interyeri/" [R=301,L]
  RewriteRule "^ua/sklo\.html$" "https://%{HTTP_HOST}/katalog/" [R=301,L]
  RewriteRule "^ua/sklo/" "https://%{HTTP_HOST}/katalog/" [R=301,L]
  RewriteRule "^ua/statti/dzerkala-dlya-vann-kiyiv_ss\.html$" "https://%{HTTP_HOST}/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^ua/statti/dzerkala-na-zamovlennya-v-kievi_ss\.html$" "https://%{HTTP_HOST}/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^ua/statti/dzerkalna-plitka-v-inter_eri_ss\.html$" "https://%{HTTP_HOST}/statti/dzerkalna-plitka-v-inter_eri/" [R=301,L]
  RewriteRule "^ua/statti/dzerkalne-panno-v-ukrayini---stilniy-ta-funktsionalniy-element_ss\.html$" "https://%{HTTP_HOST}/statti/dzerkalne-panno-v-ukrayini---stilniy-ta-funktsionalniy-element/" [R=301,L]
  RewriteRule "^ua/statti/dzerkalo-u-vannu-kimnatu-kiyiv_ss\.html$" "https://%{HTTP_HOST}/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^ua/statti/dzerkalo-u-vannu-kimnatu-kupiti-v-kievi_ss\.html$" "https://%{HTTP_HOST}/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^ua/statti/stilni-ta-praktichni-dzerkala-dlya-tantsyuvalnogo-zalu_ss\.html$" "https://%{HTTP_HOST}/statti/dzerkala-dlya-tantsyuvalnoyi-studiyi/" [R=301,L]
  RewriteRule "^ua/statti/vanne-dzerkalo-kupiti-_kiyiv__ss\.html$" "https://%{HTTP_HOST}/statti/dzerkalo-u-vannu-kimnatu-kiyiv/" [R=301,L]
  RewriteRule "^ua/statti/zamoviti-dzerkalo-_kiyiv__ss\.html$" "https://%{HTTP_HOST}/statti/dzerkala-na-zamovlennya-v-kievi/" [R=301,L]
  RewriteRule "^ua/statti/" "https://%{HTTP_HOST}/statti/" [R=301,L]
  RewriteRule "^ua/" "https://%{HTTP_HOST}/" [R=301,L]
  RewriteRule "^ru/uslugi\.html$" "https://%{HTTP_HOST}/ru/poslugy/" [R=301,L]
  RewriteRule "^ru/kontakti\.html$" "https://%{HTTP_HOST}/ru/kontakty/" [R=301,L]
  RewriteRule "^ru/zakazat-obratniy-zvonok\.html$" "https://%{HTTP_HOST}/ru/kontakty/" [R=301,L]
  RewriteRule "^ru/zakazat-proschet-stoimosti\.html$" "https://%{HTTP_HOST}/ru/kontakty/" [R=301,L]
  RewriteRule "^ru/prajs-list\.html$" "https://%{HTTP_HOST}/ru/katalog/" [R=301,L]
